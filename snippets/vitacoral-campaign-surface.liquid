{{ 'vitacoral-campaign-surfaces.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vitacoral-campaign-surfaces.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign campaign_product = product
  assign campaign_context = context | default: 'pdp'
  assign campaign_badge = campaign_product.metafields.custom.campaign_badge.value | default: campaign_product.metafields.custom.campaign_badge | strip
  assign campaign_title = campaign_product.metafields.custom.campaign_title.value | default: campaign_product.metafields.custom.campaign_title | strip
  assign campaign_code = campaign_product.metafields.custom.campaign_code.value | default: campaign_product.metafields.custom.campaign_code | strip
  assign campaign_end_date = campaign_product.metafields.custom.campaign_end_date.value | default: campaign_product.metafields.custom.campaign_end_date | strip
  assign has_sale_price = false

  if campaign_product.handle == 'collagen-30-sase' and campaign_badge == blank and campaign_title == blank and campaign_code == blank
    assign campaign_badge = 'Collagen özel'
    assign campaign_title = 'Collagen’de %10 indirim'
    assign campaign_code = 'COLLAGEN10'
  endif

  if campaign_product.compare_at_price > campaign_product.price and campaign_product.available
    assign has_sale_price = true
  endif

  if campaign_badge == blank and has_sale_price
    assign campaign_badge = 'İndirimli fiyat'
  endif

  if campaign_title == blank and has_sale_price
    assign campaign_title = 'Bu üründe indirimli fiyat var'
  endif

  assign has_campaign = false
  if campaign_badge != blank or campaign_title != blank or campaign_code != blank
    assign has_campaign = true
  endif

  assign modal_id = 'VcCampaign-' | append: campaign_context | append: '-' | append: campaign_product.id
-%}

{%- if has_campaign -%}
  <div class="vc-campaign-surface vc-campaign-surface--{{ campaign_context }}" data-vc-campaign-surface>
    <button class="vc-campaign-surface__trigger" type="button" aria-haspopup="dialog" aria-controls="{{ modal_id }}" data-vc-campaign-open>
      <span class="vc-campaign-surface__badge">{{ campaign_badge | default: 'Kampanya' | escape }}</span>
      <span class="vc-campaign-surface__text">{{ campaign_title | default: 'Kampanya detayı' | escape }}</span>
      <span class="vc-campaign-surface__chevron" aria-hidden="true">Detay</span>
    </button>

    <div class="vc-campaign-modal" id="{{ modal_id }}" role="dialog" aria-modal="true" aria-hidden="true" hidden data-vc-campaign-modal>
      <div class="vc-campaign-modal__overlay" data-vc-campaign-close></div>
      <div class="vc-campaign-modal__panel vc-campaign-modal__panel--compact" role="document">
        <button class="vc-campaign-modal__close" type="button" aria-label="Kapat" data-vc-campaign-close>×</button>
        <p class="vc-campaign-modal__eyebrow">{{ campaign_badge | default: 'Kampanya' | escape }}</p>
        <h3 class="vc-campaign-modal__title">{{ campaign_title | default: campaign_badge | default: 'Kampanya' | escape }}</h3>

        {%- if campaign_code != blank -%}
          <div class="vc-campaign-codebox">
            <code data-vc-campaign-code>{{ campaign_code | escape }}</code>
            <button class="vc-campaign-copy" type="button" data-vc-copy-code="{{ campaign_code | escape }}">Kopyala</button>
          </div>
          <p class="vc-campaign-copy-feedback" hidden data-vc-copy-feedback aria-live="polite"></p>
        {%- else -%}
          <p class="vc-campaign-modal__description">İndirim sepet ve ödeme adımında görünür.</p>
        {%- endif -%}

        <p class="vc-campaign-modal__terms">
          {%- if campaign_end_date != blank -%}
            {{ campaign_end_date | escape }} tarihine kadar geçerlidir.
          {%- else -%}
            Ödeme adımında kullanabilirsiniz.
          {%- endif -%}
        </p>
      </div>
    </div>
  </div>
{%- endif -%}
