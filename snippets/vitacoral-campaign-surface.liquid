{{ 'vitacoral-campaign-surfaces.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vitacoral-campaign-surfaces.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Vitacoral campaign surface

  Reads product metafields under custom namespace:
  - campaign_badge
  - campaign_title
  - campaign_description
  - campaign_code
  - campaign_terms
  - campaign_end_date

  Usage:
  {% render 'vitacoral-campaign-surface', product: product, context: 'pdp' %}
{%- endcomment -%}

{%- liquid
  assign campaign_product = product
  assign campaign_context = context | default: 'pdp'
  assign campaign_badge = campaign_product.metafields.custom.campaign_badge.value | default: campaign_product.metafields.custom.campaign_badge | strip
  assign campaign_title = campaign_product.metafields.custom.campaign_title.value | default: campaign_product.metafields.custom.campaign_title | strip
  assign campaign_description = campaign_product.metafields.custom.campaign_description.value | default: campaign_product.metafields.custom.campaign_description | strip
  assign campaign_code = campaign_product.metafields.custom.campaign_code.value | default: campaign_product.metafields.custom.campaign_code | strip
  assign campaign_terms = campaign_product.metafields.custom.campaign_terms.value | default: campaign_product.metafields.custom.campaign_terms | strip
  assign campaign_end_date = campaign_product.metafields.custom.campaign_end_date.value | default: campaign_product.metafields.custom.campaign_end_date | strip
  assign has_sale_price = false

  if campaign_product.handle == 'collagen-30-sase' and campaign_badge == blank and campaign_title == blank and campaign_description == blank and campaign_code == blank
    assign campaign_badge = 'Collagen özel'
    assign campaign_title = 'Collagen için özel başlangıç fırsatı'
    assign campaign_description = 'COLLAGEN10 koduyla Collagen ürününde indirim fırsatını kullanabilirsiniz.'
    assign campaign_code = 'COLLAGEN10'
    assign campaign_terms = 'Kampanya koşulları sepet ve ödeme adımında geçerlidir.'
  endif

  if campaign_product.compare_at_price > campaign_product.price and campaign_product.available
    assign has_sale_price = true
  endif

  if campaign_badge == blank and has_sale_price
    assign campaign_badge = 'İndirimli fiyat'
  endif

  if campaign_title == blank and has_sale_price
    assign campaign_title = 'Bu üründe indirimli fiyat var'
  endif

  if campaign_description == blank and has_sale_price
    assign campaign_description = 'Ürün fiyatı indirimli olarak gösterilir. Sepet ve ödeme adımında güncel fiyatı kontrol edebilirsiniz.'
  endif

  assign has_campaign = false
  if campaign_badge != blank or campaign_title != blank or campaign_description != blank or campaign_code != blank or campaign_terms != blank
    assign has_campaign = true
  endif

  assign modal_id = 'VcCampaign-' | append: campaign_context | append: '-' | append: campaign_product.id
-%}

{%- if has_campaign -%}
  <div class="vc-campaign-surface vc-campaign-surface--{{ campaign_context }}" data-vc-campaign-surface>
    <button class="vc-campaign-surface__trigger" type="button" aria-haspopup="dialog" aria-controls="{{ modal_id }}" data-vc-campaign-open>
      <span class="vc-campaign-surface__badge">{{ campaign_badge | default: 'Kampanya' | escape }}</span>
      <span class="vc-campaign-surface__text">
        {{ campaign_title | default: campaign_description | default: 'Kampanya detayları' | escape }}
      </span>
      <span class="vc-campaign-surface__chevron" aria-hidden="true">Detay</span>
    </button>

    <div class="vc-campaign-modal" id="{{ modal_id }}" role="dialog" aria-modal="true" aria-hidden="true" hidden data-vc-campaign-modal>
      <div class="vc-campaign-modal__overlay" data-vc-campaign-close></div>
      <div class="vc-campaign-modal__panel" role="document">
        <button class="vc-campaign-modal__close" type="button" aria-label="Kampanya detaylarını kapat" data-vc-campaign-close>×</button>
        <p class="vc-campaign-modal__eyebrow">Kampanya detayı</p>
        <h3 class="vc-campaign-modal__title">{{ campaign_title | default: campaign_badge | default: 'Kampanya' | escape }}</h3>

        {%- if campaign_description != blank -%}
          <p class="vc-campaign-modal__description">{{ campaign_description | escape }}</p>
        {%- endif -%}

        <dl class="vc-campaign-modal__facts">
          {%- if campaign_code != blank -%}
            <div class="vc-campaign-modal__fact">
              <dt>Kod</dt>
              <dd><code>{{ campaign_code | escape }}</code></dd>
            </div>
          {%- else -%}
            <div class="vc-campaign-modal__fact">
              <dt>Uygulama</dt>
              <dd>Koşullar uygunsa indirim sepet/ödeme adımında görünür.</dd>
            </div>
          {%- endif -%}

          {%- if campaign_end_date != blank -%}
            <div class="vc-campaign-modal__fact">
              <dt>Geçerlilik</dt>
              <dd>{{ campaign_end_date | escape }}</dd>
            </div>
          {%- endif -%}
        </dl>

        {%- if campaign_terms != blank -%}
          <p class="vc-campaign-modal__terms">{{ campaign_terms | escape }}</p>
        {%- endif -%}

        <a class="vc-campaign-modal__cta" href="{{ campaign_product.url }}">Ürünü incele</a>
      </div>
    </div>
  </div>
{%- endif -%}
