<section class="vc-trust-grid section" id="VcTrustGrid-{{ section.id }}">
  {%- style -%}
    #VcTrustGrid-{{ section.id }} {
      padding: clamp(1.4rem, 3vw, 2.6rem) 0 clamp(2.8rem, 4.5vw, 5.2rem);
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__layout {
      display: grid;
      gap: clamp(1.8rem, 3vw, 2.8rem);
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__intro {
      position: relative;
      max-width: 72rem;
      display: grid;
      gap: 1rem;
      padding-left: 1.6rem;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__intro::before {
      content: '';
      position: absolute;
      top: 0.25rem;
      bottom: 0.25rem;
      left: 0;
      width: 0.35rem;
      border-radius: 999px;
      background: linear-gradient(180deg, #225952, #ec6542);
      opacity: 0.78;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__eyebrow {
      margin: 0;
      color: var(--vitacoral-color-primary);
      font-family: var(--vitacoral-font-ui);
      font-size: 1.12rem;
      font-weight: 800;
      letter-spacing: 0.17em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__heading {
      margin: 0;
      color: var(--vitacoral-color-text);
      font-family: var(--vitacoral-font-brand);
      font-size: clamp(2.5rem, 4vw, 4rem);
      font-weight: 650;
      letter-spacing: -0.04em;
      line-height: 1.04;
      text-wrap: balance;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__body {
      color: var(--vitacoral-color-text-muted);
      font-family: var(--vitacoral-font-body);
      font-size: 1.62rem;
      line-height: 1.68;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__body > *:first-child {
      margin-top: 0;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__body > *:last-child {
      margin-bottom: 0;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__items {
      display: grid;
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 1.4rem;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__card {
      position: relative;
      overflow: hidden;
      height: 100%;
      padding: 2rem;
      background:
        radial-gradient(circle at top right, rgba(34, 89, 82, 0.08), transparent 36%),
        linear-gradient(180deg, rgba(255, 255, 255, 1), rgba(248, 250, 249, 0.96));
      border: 0.1rem solid rgba(34, 89, 82, 0.1);
      border-radius: var(--vitacoral-radius-lg);
      box-shadow: 0 1.2rem 2.8rem rgba(21, 44, 41, 0.055);
      transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 0.45rem;
      background: linear-gradient(90deg, rgba(34, 89, 82, 0.88), rgba(236, 101, 66, 0.78));
      opacity: 0.72;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__card::after {
      content: '';
      position: absolute;
      right: -3rem;
      bottom: -3rem;
      width: 9rem;
      height: 9rem;
      border-radius: 999px;
      background: rgba(34, 89, 82, 0.045);
      pointer-events: none;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__card--orange {
      background:
        radial-gradient(circle at top right, rgba(236, 101, 66, 0.12), transparent 38%),
        linear-gradient(180deg, rgba(255, 248, 245, 1), rgba(255, 252, 250, 0.98));
      border-color: rgba(236, 101, 66, 0.14);
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__card--orange::before {
      background: linear-gradient(90deg, rgba(236, 101, 66, 0.9), rgba(34, 89, 82, 0.66));
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__card--orange::after {
      background: rgba(236, 101, 66, 0.065);
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__card--soft {
      background:
        radial-gradient(circle at top right, rgba(236, 101, 66, 0.08), transparent 36%),
        linear-gradient(180deg, rgba(236, 245, 243, 0.92), rgba(255, 255, 255, 0.98));
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__card:hover {
      transform: translateY(-0.25rem);
      border-color: rgba(34, 89, 82, 0.18);
      box-shadow: 0 1.6rem 3.4rem rgba(21, 44, 41, 0.08);
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__label {
      position: relative;
      z-index: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.9rem;
      margin-bottom: 1.3rem;
      padding: 0.5rem 1rem;
      color: var(--vitacoral-color-primary-deep, #163d38);
      font-family: var(--vitacoral-font-ui);
      font-size: 1.06rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      line-height: 1;
      text-transform: uppercase;
      background: rgba(255, 255, 255, 0.74);
      border: 0.1rem solid rgba(34, 89, 82, 0.12);
      border-radius: var(--vitacoral-radius-pill);
      box-shadow: 0 0.5rem 1.3rem rgba(21, 44, 41, 0.04);
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__card--orange .vc-trust-grid__label {
      color: #9f3e25;
      border-color: rgba(236, 101, 66, 0.18);
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__title {
      position: relative;
      z-index: 1;
      margin: 0 0 0.8rem;
      color: var(--vitacoral-color-text);
      font-family: var(--vitacoral-font-brand);
      font-size: 2.15rem;
      font-weight: 650;
      letter-spacing: -0.035em;
      line-height: 1.08;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__text {
      position: relative;
      z-index: 1;
      margin: 0;
      color: var(--vitacoral-color-text-muted);
      font-family: var(--vitacoral-font-body);
      font-size: 1.52rem;
      line-height: 1.64;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__empty {
      padding: 1.8rem;
      color: var(--vitacoral-color-text-muted);
      background: rgba(255, 255, 255, 0.9);
      border: 0.1rem dashed rgba(34, 89, 82, 0.14);
      border-radius: var(--vitacoral-radius-lg);
      text-align: center;
    }

    @media screen and (min-width: 750px) {
      #VcTrustGrid-{{ section.id }} .vc-trust-grid__items {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #VcTrustGrid-{{ section.id }} {
        padding-top: 0.8rem;
      }

      #VcTrustGrid-{{ section.id }} .vc-trust-grid__intro {
        padding-left: 1.2rem;
      }

      #VcTrustGrid-{{ section.id }} .vc-trust-grid__card,
      #VcTrustGrid-{{ section.id }} .vc-trust-grid__empty {
        padding: 1.6rem;
      }

      #VcTrustGrid-{{ section.id }} .vc-trust-grid__heading {
        font-size: 2.35rem;
      }

      #VcTrustGrid-{{ section.id }} .vc-trust-grid__card:hover {
        transform: none;
      }
    }
  {%- endstyle -%}

  <div class="page-width page-width--narrow">
    <div class="vc-trust-grid__layout">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.body != blank -%}
        <div class="vc-trust-grid__intro">
          {%- if section.settings.eyebrow != blank -%}
            <p class="vc-trust-grid__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="vc-trust-grid__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <div class="vc-trust-grid__body rte">
              {{ section.settings.body }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="vc-trust-grid__items" role="list">
          {%- for block in section.blocks -%}
            <article class="vc-trust-grid__card vc-trust-grid__card--{{ block.settings.accent_style }}" role="listitem" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                <span class="vc-trust-grid__label">{{ block.settings.label | escape }}</span>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="vc-trust-grid__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <p class="vc-trust-grid__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      {%- elsif request.design_mode -%}
        <div class="vc-trust-grid__empty">
          Trust/value cards can be added here from the Theme Editor.
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral Trust Grid",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Vitacoral yaklaşımı"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Güven oluşturan temel başlıklar"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    }
  ],
  "blocks": [
    {
      "type": "trust_card",
      "name": "Trust card",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Optional label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "accent_style",
          "label": "Accent style",
          "default": "green",
          "options": [
            {
              "value": "green",
              "label": "Green"
            },
            {
              "value": "orange",
              "label": "Orange"
            },
            {
              "value": "soft",
              "label": "Soft"
            }
          ]
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Vitacoral Trust Grid",
      "blocks": [
        {
          "type": "trust_card"
        },
        {
          "type": "trust_card"
        },
        {
          "type": "trust_card"
        }
      ]
    }
  ]
}
{% endschema %}
