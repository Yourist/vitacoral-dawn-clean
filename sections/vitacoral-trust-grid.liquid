<section class="vc-trust-grid section" id="VcTrustGrid-{{ section.id }}">
  {%- style -%}
    #VcTrustGrid-{{ section.id }} {
      padding: clamp(1.2rem, 3vw, 2.4rem) 0 clamp(2.4rem, 4vw, 4.8rem);
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__layout {
      display: grid;
      gap: clamp(1.6rem, 3vw, 2.4rem);
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__intro {
      max-width: 70rem;
      display: grid;
      gap: 1rem;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__eyebrow {
      margin: 0;
      color: var(--vitacoral-color-primary);
      font-family: var(--vitacoral-font-ui);
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__heading {
      margin: 0;
      color: var(--vitacoral-color-text);
      font-family: var(--vitacoral-font-brand);
      font-size: clamp(2.4rem, 4vw, 3.8rem);
      font-weight: 600;
      letter-spacing: -0.03em;
      line-height: 1.06;
      text-wrap: balance;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__body {
      color: var(--vitacoral-color-text-muted);
      font-family: var(--vitacoral-font-body);
      font-size: 1.6rem;
      line-height: 1.68;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__body > *:first-child {
      margin-top: 0;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__body > *:last-child {
      margin-bottom: 0;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__items {
      display: grid;
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 1.2rem;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__card {
      height: 100%;
      padding: 1.8rem;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 1), rgba(248, 250, 249, 0.97));
      border: 0.1rem solid rgba(34, 89, 82, 0.08);
      border-radius: var(--vitacoral-radius-lg);
      box-shadow: 0 1rem 2.4rem rgba(21, 44, 41, 0.05);
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__card--orange {
      background:
        linear-gradient(180deg, rgba(255, 248, 245, 1), rgba(255, 252, 250, 0.98));
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__card--soft {
      background:
        linear-gradient(180deg, rgba(236, 245, 243, 0.9), rgba(255, 255, 255, 0.98));
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__label {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.8rem;
      margin-bottom: 1.2rem;
      padding: 0.45rem 0.95rem;
      color: var(--vitacoral-color-primary);
      font-family: var(--vitacoral-font-ui);
      font-size: 1.08rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      line-height: 1;
      text-transform: uppercase;
      background: rgba(34, 89, 82, 0.08);
      border-radius: var(--vitacoral-radius-pill);
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__title {
      margin: 0 0 0.8rem;
      color: var(--vitacoral-color-text);
      font-family: var(--vitacoral-font-brand);
      font-size: 2.1rem;
      font-weight: 600;
      letter-spacing: -0.03em;
      line-height: 1.1;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__text {
      margin: 0;
      color: var(--vitacoral-color-text-muted);
      font-family: var(--vitacoral-font-body);
      font-size: 1.5rem;
      line-height: 1.62;
    }

    #VcTrustGrid-{{ section.id }} .vc-trust-grid__empty {
      padding: 1.8rem;
      color: var(--vitacoral-color-text-muted);
      background: rgba(255, 255, 255, 0.9);
      border: 0.1rem dashed rgba(34, 89, 82, 0.14);
      border-radius: var(--vitacoral-radius-lg);
      text-align: center;
    }

    @media screen and (min-width: 750px) {
      #VcTrustGrid-{{ section.id }} .vc-trust-grid__items {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #VcTrustGrid-{{ section.id }} {
        padding-top: 0.6rem;
      }

      #VcTrustGrid-{{ section.id }} .vc-trust-grid__card,
      #VcTrustGrid-{{ section.id }} .vc-trust-grid__empty {
        padding: 1.5rem;
      }

      #VcTrustGrid-{{ section.id }} .vc-trust-grid__heading {
        font-size: 2.3rem;
      }
    }
  {%- endstyle -%}

  <div class="page-width page-width--narrow">
    <div class="vc-trust-grid__layout">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.body != blank -%}
        <div class="vc-trust-grid__intro">
          {%- if section.settings.eyebrow != blank -%}
            <p class="vc-trust-grid__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="vc-trust-grid__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <div class="vc-trust-grid__body rte">
              {{ section.settings.body }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="vc-trust-grid__items" role="list">
          {%- for block in section.blocks -%}
            <article class="vc-trust-grid__card vc-trust-grid__card--{{ block.settings.accent_style }}" role="listitem" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                <span class="vc-trust-grid__label">{{ block.settings.label | escape }}</span>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="vc-trust-grid__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <p class="vc-trust-grid__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      {%- elsif request.design_mode -%}
        <div class="vc-trust-grid__empty">
          Trust/value cards can be added here from the Theme Editor.
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral Trust Grid",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Vitacoral yaklaşımı"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Güven oluşturan temel başlıklar"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    }
  ],
  "blocks": [
    {
      "type": "trust_card",
      "name": "Trust card",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Optional label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "accent_style",
          "label": "Accent style",
          "default": "green",
          "options": [
            {
              "value": "green",
              "label": "Green"
            },
            {
              "value": "orange",
              "label": "Orange"
            },
            {
              "value": "soft",
              "label": "Soft"
            }
          ]
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Vitacoral Trust Grid",
      "blocks": [
        {
          "type": "trust_card"
        },
        {
          "type": "trust_card"
        },
        {
          "type": "trust_card"
        }
      ]
    }
  ]
}
{% endschema %}
