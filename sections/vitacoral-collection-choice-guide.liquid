{%- liquid
  assign primary_link = section.settings.primary_link
  assign secondary_link = section.settings.secondary_link

  if primary_link == blank
    assign primary_link = '/pages/kadin-gunluk-rutini'
  endif

  if secondary_link == blank
    assign secondary_link = '/collections/all'
  endif
-%}

<section class="vc-collection-guide" id="VCCollectionGuide-{{ section.id }}">
  <div class="page-width">
    <div class="vc-collection-guide__shell">
      <div class="vc-collection-guide__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vc-collection-guide__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.body | escape }}</p>
      </div>

      <div class="vc-collection-guide__cards" aria-label="Ürün seçim alanları">
        <a class="vc-collection-guide__card" href="/products/collagen-30-sase">
          <span>Collagen</span>
          <small>Beauty rutini</small>
        </a>
        <a class="vc-collection-guide__card" href="/pages/kadin-gunluk-rutini">
          <span>Women</span>
          <small>Günlük destek</small>
        </a>
        <a class="vc-collection-guide__card" href="/pages/erkek-gunluk-rutini">
          <span>Men</span>
          <small>Günlük destek</small>
        </a>
        <a class="vc-collection-guide__card" href="/pages/aile-gunluk-rutini">
          <span>Kids</span>
          <small>Aile rutini</small>
        </a>
      </div>

      <div class="vc-collection-guide__actions">
        <a class="vc-collection-guide__primary" href="{{ primary_link }}">{{ section.settings.primary_label | escape }}</a>
        <a class="vc-collection-guide__secondary" href="{{ secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .vc-collection-guide{padding:0 0 1.4rem;background:linear-gradient(180deg,rgba(247,250,249,.74),rgba(255,255,255,.98))}.vc-collection-guide__shell{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(28rem,.95fr);gap:1.25rem;align-items:center;padding:1.35rem;border:.1rem solid rgba(34,89,82,.12);border-radius:2rem;background:radial-gradient(circle at 95% 0%,rgba(208,168,94,.22),transparent 30%),#fff;box-shadow:0 1rem 2.4rem rgba(21,44,41,.055)}.vc-collection-guide__eyebrow{margin:0 0 .4rem;color:#d0a85e;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:.92rem;font-weight:950;letter-spacing:.14em;text-transform:uppercase}.vc-collection-guide h2{margin:0;color:var(--vitacoral-color-text,#16312e);font-family:var(--vitacoral-font-brand,"Gibbs Book",Arial,sans-serif);font-size:clamp(2rem,3.2vw,3rem);font-weight:650;letter-spacing:-.045em;line-height:1.05}.vc-collection-guide p{max-width:58rem;margin:.62rem 0 0;color:rgba(22,49,46,.72);font-family:var(--vitacoral-font-body,"Manrope",Arial,sans-serif);font-size:1.08rem;line-height:1.5}.vc-collection-guide__cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem}.vc-collection-guide__card{display:grid;gap:.2rem;min-height:6.2rem;padding:.9rem 1rem;border:.1rem solid rgba(34,89,82,.1);border-radius:1.35rem;background:linear-gradient(180deg,rgba(247,250,249,.95),#fff);color:var(--vitacoral-color-text,#16312e);text-decoration:none;box-shadow:0 .55rem 1.2rem rgba(21,44,41,.04)}.vc-collection-guide__card span{font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:1.16rem;font-weight:950;line-height:1.1}.vc-collection-guide__card small{color:rgba(22,49,46,.62);font-family:var(--vitacoral-font-body,"Manrope",Arial,sans-serif);font-size:.92rem;line-height:1.25}.vc-collection-guide__actions{grid-column:1 / -1;display:flex;flex-wrap:wrap;gap:.55rem}.vc-collection-guide__primary,.vc-collection-guide__secondary{display:inline-flex;align-items:center;justify-content:center;min-height:3.85rem;padding:.8rem 1rem;border-radius:999px;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:1rem;font-weight:900;text-decoration:none}.vc-collection-guide__primary{background:#225952;color:#fff}.vc-collection-guide__secondary{border:.1rem solid rgba(34,89,82,.18);background:rgba(34,89,82,.06);color:#225952}@media screen and (max-width:749px){.vc-collection-guide{padding:0 0 1rem}.vc-collection-guide .page-width{padding-left:1.6rem;padding-right:1.6rem}.vc-collection-guide__shell{grid-template-columns:1fr;gap:1rem;padding:1.05rem;border-radius:1.45rem}.vc-collection-guide h2{font-size:2.05rem}.vc-collection-guide p{font-size:.98rem;line-height:1.45}.vc-collection-guide__cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.vc-collection-guide__card{min-height:5.5rem;padding:.78rem .82rem;border-radius:1.12rem}.vc-collection-guide__card span{font-size:1.02rem}.vc-collection-guide__card small{font-size:.82rem}.vc-collection-guide__primary,.vc-collection-guide__secondary{min-height:3.45rem;padding:.72rem .9rem;font-size:.92rem}}
</style>

{% schema %}
{
  "name": "Koleksiyon seçim rehberi",
  "tag": "section",
  "class": "section",
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Seçim rehberi"},
    {"type":"text","id":"heading","label":"Başlık","default":"Ürünü rutininize göre seçin"},
    {"type":"textarea","id":"body","label":"Açıklama","default":"Vitacoral ürünlerini günlük kullanım alışkanlığınıza, içerik beklentinize ve aile rutininize göre daha kolay karşılaştırabilirsiniz."},
    {"type":"text","id":"primary_label","label":"Birincil CTA","default":"Rutininizi bulun"},
    {"type":"url","id":"primary_link","label":"Birincil link"},
    {"type":"text","id":"secondary_label","label":"İkincil CTA","default":"Tüm ürünleri gör"},
    {"type":"url","id":"secondary_link","label":"İkincil link"}
  ],
  "presets": [{"name":"Koleksiyon seçim rehberi"}]
}
{% endschema %}
