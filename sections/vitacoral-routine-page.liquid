{{ 'vitacoral-routine-pages.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_product_one = blank
  assign hero_product_two = blank
  assign hero_image_one = blank
  assign hero_image_two = blank
  for block in section.blocks
    if block.type == 'routine_product'
      if hero_product_one == blank
        assign hero_product_one = block.settings.product
        assign hero_image_one = block.settings.image
        if hero_image_one == blank and hero_product_one != blank
          assign hero_image_one = hero_product_one.featured_image
        endif
      elsif hero_product_two == blank
        assign hero_product_two = block.settings.product
        assign hero_image_two = block.settings.image
        if hero_image_two == blank and hero_product_two != blank
          assign hero_image_two = hero_product_two.featured_image
        endif
      endif
    endif
  endfor
-%}

<section class="vc-routine-page" id="VitacoralRoutinePage-{{ section.id }}">
  <div class="page-width vc-routine-page__inner">
    <div class="vc-routine-hero">
      <div class="vc-routine-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vc-routine-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="vc-routine-title">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="vc-routine-body rte">{{ section.settings.body }}</div>
        {%- endif -%}
        <div class="vc-routine-hero__actions">
          <a class="vc-routine-button vc-routine-button--hero" href="#routine-products">Rutini keşfet</a>
          {%- if section.settings.hero_note != blank -%}
            <span class="vc-routine-hero__microcopy">{{ section.settings.hero_note | escape }}</span>
          {%- endif -%}
        </div>
      </div>

      <div class="vc-routine-hero__visual" aria-label="Rutin ürün görseli">
        <div class="vc-routine-visual-card vc-routine-visual-card--primary">
          {%- if hero_image_one != blank -%}
            {{
              hero_image_one
              | image_url: width: 900
              | image_tag:
                widths: '360, 520, 720, 900',
                sizes: '(min-width: 990px) 28vw, 62vw',
                loading: 'eager',
                alt: hero_product_one.title,
                class: 'vc-routine-visual-card__image'
            }}
          {%- endif -%}
        </div>
        <div class="vc-routine-visual-card vc-routine-visual-card--secondary">
          {%- if hero_image_two != blank -%}
            {{
              hero_image_two
              | image_url: width: 700
              | image_tag:
                widths: '300, 480, 700',
                sizes: '(min-width: 990px) 18vw, 42vw',
                loading: 'eager',
                alt: hero_product_two.title,
                class: 'vc-routine-visual-card__image'
            }}
          {%- endif -%}
        </div>
        <div class="vc-routine-visual-badge vc-routine-visual-badge--top">{{ section.settings.orbit_1 | escape }}</div>
        <div class="vc-routine-visual-badge vc-routine-visual-badge--bottom">{{ section.settings.orbit_2 | escape }}</div>
        <div class="vc-routine-visual-glow" aria-hidden="true"></div>
      </div>
    </div>

    <div class="vc-routine-section" id="routine-products">
      <div class="vc-routine-section__header vc-routine-section__header--compact">
        {%- if section.settings.products_heading != blank -%}
          <h2 class="vc-routine-section__title">{{ section.settings.products_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.products_body != blank -%}
          <div class="vc-routine-section__body rte">{{ section.settings.products_body }}</div>
        {%- endif -%}
      </div>

      <div class="vc-routine-products" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'routine_product' -%}
            {%- liquid
              assign routine_product = block.settings.product
              assign custom_title = block.settings.title | strip
              assign product_title = custom_title
              if product_title == blank and routine_product != blank
                assign product_title = routine_product.title
              endif
              assign product_image = block.settings.image
              if product_image == blank and routine_product != blank and routine_product.featured_image != blank
                assign product_image = routine_product.featured_image
              endif
              assign image_alt = product_title
              if product_image != blank and product_image.alt != blank
                assign image_alt = product_image.alt
              endif
              assign product_url = '#'
              if routine_product != blank
                assign product_url = routine_product.url
              endif
            -%}
            <article class="vc-routine-product" role="listitem" {{ block.shopify_attributes }}>
              <div class="vc-routine-product__media">
                {%- if product_image != blank -%}
                  {{
                    product_image
                    | image_url: width: 900
                    | image_tag:
                      widths: '320, 480, 700, 900',
                      sizes: '(min-width: 990px) 34vw, 92vw',
                      loading: 'lazy',
                      alt: image_alt,
                      class: 'vc-routine-product__image'
                  }}
                {%- else -%}
                  <div class="vc-routine-product__placeholder">{{ product_title | default: 'Vitacoral ürünü' | escape }}</div>
                {%- endif -%}
              </div>
              <div class="vc-routine-product__content">
                {%- if block.settings.kicker != blank -%}
                  <p class="vc-routine-product__kicker">{{ block.settings.kicker | escape }}</p>
                {%- endif -%}
                <h3 class="vc-routine-product__title">{{ product_title | default: 'Vitacoral ürünü' | escape }}</h3>
                {%- if block.settings.text != blank -%}
                  <p class="vc-routine-product__text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
                {%- if routine_product != blank -%}
                  <div class="vc-routine-product__price">
                    {% render 'price', product: routine_product, show_compare_at_price: true %}
                  </div>
                {%- endif -%}
              </div>
              <div class="vc-routine-product__actions">
                <a class="vc-routine-button" href="{{ product_url }}">
                  {{ block.settings.cta_label | default: 'Ürünü incele' | escape }}
                </a>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="vc-routine-section vc-routine-section--insights">
      <div class="vc-routine-section__header">
        {%- if section.settings.insight_heading != blank -%}
          <h2 class="vc-routine-section__title">{{ section.settings.insight_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.insight_body != blank -%}
          <div class="vc-routine-section__body rte">{{ section.settings.insight_body }}</div>
        {%- endif -%}
      </div>
      <div class="vc-routine-insights">
        <article class="vc-routine-insight">
          <span class="vc-routine-insight__label">01</span>
          <h3 class="vc-routine-insight__title">{{ section.settings.insight_1_title | escape }}</h3>
          <p class="vc-routine-insight__text">{{ section.settings.insight_1_text | escape }}</p>
        </article>
        <article class="vc-routine-insight">
          <span class="vc-routine-insight__label">02</span>
          <h3 class="vc-routine-insight__title">{{ section.settings.insight_2_title | escape }}</h3>
          <p class="vc-routine-insight__text">{{ section.settings.insight_2_text | escape }}</p>
        </article>
        <article class="vc-routine-insight vc-routine-insight--accent">
          <span class="vc-routine-insight__label">03</span>
          <h3 class="vc-routine-insight__title">{{ section.settings.insight_3_title | escape }}</h3>
          <p class="vc-routine-insight__text">{{ section.settings.insight_3_text | escape }}</p>
        </article>
      </div>
    </div>

    <div class="vc-routine-section vc-routine-section--steps">
      <div class="vc-routine-section__header vc-routine-section__header--compact">
        {%- if section.settings.steps_heading != blank -%}
          <h2 class="vc-routine-section__title">{{ section.settings.steps_heading }}</h2>
        {%- endif -%}
      </div>
      <div class="vc-routine-steps">
        <div class="vc-routine-step">
          <span class="vc-routine-step__index">01</span>
          <h3 class="vc-routine-step__title">{{ section.settings.step_1_title | escape }}</h3>
          <p class="vc-routine-step__text">{{ section.settings.step_1_text | escape }}</p>
        </div>
        <div class="vc-routine-step">
          <span class="vc-routine-step__index">02</span>
          <h3 class="vc-routine-step__title">{{ section.settings.step_2_title | escape }}</h3>
          <p class="vc-routine-step__text">{{ section.settings.step_2_text | escape }}</p>
        </div>
        <div class="vc-routine-step">
          <span class="vc-routine-step__index">03</span>
          <h3 class="vc-routine-step__title">{{ section.settings.step_3_title | escape }}</h3>
          <p class="vc-routine-step__text">{{ section.settings.step_3_text | escape }}</p>
        </div>
      </div>
    </div>

    {%- if section.settings.final_heading != blank or section.settings.final_body != blank -%}
      <div class="vc-routine-final">
        {%- if section.settings.final_heading != blank -%}
          <h2 class="vc-routine-final__title">{{ section.settings.final_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.final_body != blank -%}
          <p class="vc-routine-final__text">{{ section.settings.final_body | escape }}</p>
        {%- endif -%}
        {%- if section.settings.final_cta_label != blank and section.settings.final_cta_link != blank -%}
          <a class="vc-routine-final__link" href="{{ section.settings.final_cta_link }}">{{ section.settings.final_cta_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral Routine Page",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Vitacoral rutini" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Günlük rutininizi sadeleştirin" },
    { "type": "richtext", "id": "body", "label": "Hero body", "default": "<p>Günlük destek ürünlerini daha anlaşılır bir rutin içinde keşfedin.</p>" },
    { "type": "text", "id": "orbit_1", "label": "Visual badge 1", "default": "Günlük destek" },
    { "type": "text", "id": "orbit_2", "label": "Visual badge 2", "default": "Sade seçim" },
    { "type": "text", "id": "orbit_3", "label": "Reserved badge", "default": "Güvenli alışveriş" },
    { "type": "text", "id": "hero_note", "label": "Hero microcopy", "default": "Ürün detaylarını inceleyerek karar verin." },
    { "type": "inline_richtext", "id": "products_heading", "label": "Products heading", "default": "Bu rutinde neler var?" },
    { "type": "richtext", "id": "products_body", "label": "Products body", "default": "<p>Rutine uygun ürünleri tek bakışta inceleyin.</p>" },
    { "type": "inline_richtext", "id": "insight_heading", "label": "Insight heading", "default": "Bu rutin kime uygun?" },
    { "type": "richtext", "id": "insight_body", "label": "Insight body", "default": "<p>Kısa karar notlarıyla rutinin mantığını daha net görün.</p>" },
    { "type": "text", "id": "insight_1_title", "label": "Insight 1 title", "default": "Kimler için?" },
    { "type": "text", "id": "insight_1_text", "label": "Insight 1 text", "default": "Günlük destek ürünlerini sade bir akışta incelemek isteyen kullanıcılar için." },
    { "type": "text", "id": "insight_2_title", "label": "Insight 2 title", "default": "Birlikte nasıl düşünülür?" },
    { "type": "text", "id": "insight_2_text", "label": "Insight 2 text", "default": "Multivitamin rutinin temelini kurar; kolajen ürünü bu akışa tamamlayıcı bir ürün olarak eklenir." },
    { "type": "text", "id": "insight_3_title", "label": "Insight 3 title", "default": "Rutinde neyi kolaylaştırır?" },
    { "type": "text", "id": "insight_3_text", "label": "Insight 3 text", "default": "Ürünleri tek tek aramak yerine, aynı kullanım hikayesi içinde karşılaştırmayı kolaylaştırır." },
    { "type": "inline_richtext", "id": "steps_heading", "label": "Steps heading", "default": "3 adımda rutin" },
    { "type": "richtext", "id": "steps_body", "label": "Steps body", "default": "<p></p>" },
    { "type": "text", "id": "step_1_title", "label": "Step 1 title", "default": "Seç" },
    { "type": "text", "id": "step_1_text", "label": "Step 1 text", "default": "Size yakın ürün ailesini seçin." },
    { "type": "text", "id": "step_2_title", "label": "Step 2 title", "default": "İncele" },
    { "type": "text", "id": "step_2_text", "label": "Step 2 text", "default": "İçerik ve kullanım bilgilerine bakın." },
    { "type": "text", "id": "step_3_title", "label": "Step 3 title", "default": "Tamamla" },
    { "type": "text", "id": "step_3_text", "label": "Step 3 text", "default": "Ürün detayından alışverişe devam edin." },
    { "type": "inline_richtext", "id": "final_heading", "label": "Final heading", "default": "Rutinini tamamla" },
    { "type": "text", "id": "final_body", "label": "Final body", "default": "Tüm Vitacoral ürünlerini keşfederek size en yakın rutini oluşturabilirsiniz." },
    { "type": "text", "id": "final_cta_label", "label": "Final CTA label", "default": "Tüm ürünleri keşfet" },
    { "type": "url", "id": "final_cta_link", "label": "Final CTA link", "default": "/collections/all" }
  ],
  "blocks": [
    {
      "type": "routine_product",
      "name": "Routine product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Rutindeki ürün" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "text", "label": "Short text", "default": "Bu ürünü rutininizin bir parçası olarak inceleyebilirsiniz." },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Ürünü incele" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Vitacoral Routine Page",
      "blocks": [
        { "type": "routine_product" },
        { "type": "routine_product" }
      ]
    }
  ]
}
{% endschema %}
