{%- liquid
  assign has_collagen = false
  assign has_women = false
  assign has_men = false
  assign has_kids = false
  assign has_glucomannan = false

  for item in cart.items
    case item.product.handle
      when 'collagen-30-sase'
        assign has_collagen = true
      when 'multivitamin-for-women'
        assign has_women = true
      when 'multivitamin-for-men'
        assign has_men = true
      when 'multivitamin-for-kids'
        assign has_kids = true
      when 'vitacoral-glucomannan-60-sase'
        assign has_glucomannan = true
    endcase
  endfor

  assign assist_title = section.settings.heading
  assign assist_body = section.settings.body
  assign primary_label = section.settings.primary_label
  assign primary_link = section.settings.primary_link
  assign secondary_label = section.settings.secondary_label
  assign secondary_link = section.settings.secondary_link

  if primary_link == blank
    assign primary_link = '/pages/kadin-gunluk-rutini'
  endif

  if secondary_link == blank
    assign secondary_link = '/collections/all'
  endif

  if has_collagen and has_women == false and has_men == false
    assign assist_title = 'Rutini tamamlayın'
    assign assist_body = 'Collagen seçiminizi günlük multivitamin rutiniyle birlikte değerlendirebilirsiniz. Kadın veya erkek rutinleri, ürünü günlük akış içinde düşünmenizi kolaylaştırır.'
    assign primary_label = 'Kadın rutini'
    assign primary_link = '/pages/kadin-gunluk-rutini'
    assign secondary_label = 'Erkek rutini'
    assign secondary_link = '/pages/erkek-gunluk-rutini'
  elsif has_women and has_collagen == false
    assign assist_title = 'Birlikte düşünün'
    assign assist_body = 'Women multivitamin seçiminizi Collagen ile birlikte değerlendirmek isterseniz kadın günlük rutini sayfasından önerilen akışı inceleyebilirsiniz.'
    assign primary_label = 'Kadın rutini'
    assign primary_link = '/pages/kadin-gunluk-rutini'
    assign secondary_label = 'Collagen incele'
    assign secondary_link = '/products/collagen-30-sase'
  elsif has_men and has_collagen == false
    assign assist_title = 'Birlikte düşünün'
    assign assist_body = 'Men multivitamin seçiminizi Collagen ile birlikte değerlendirmek isterseniz erkek günlük rutini sayfasından önerilen akışı inceleyebilirsiniz.'
    assign primary_label = 'Erkek rutini'
    assign primary_link = '/pages/erkek-gunluk-rutini'
    assign secondary_label = 'Collagen incele'
    assign secondary_link = '/products/collagen-30-sase'
  elsif has_kids
    assign assist_title = 'Aile rutini'
    assign assist_body = 'Kids ürününü ebeveyn kontrolünde değerlendirirken aile rutini içindeki diğer seçenekleri de birlikte inceleyebilirsiniz.'
    assign primary_label = 'Aile rutini'
    assign primary_link = '/pages/aile-gunluk-rutini'
    assign secondary_label = 'Ürünleri gör'
    assign secondary_link = '/collections/all'
  elsif has_glucomannan
    assign assist_title = 'Hafif rutin'
    assign assist_body = 'Glucomannan seçiminde kullanım önerisi, su tüketimi ve etiket uyarıları önemlidir. Hafif rutin sayfasından ürünü günlük düzeniniz içinde değerlendirebilirsiniz.'
    assign primary_label = 'Hafif rutin'
    assign primary_link = '/pages/hafif-rutin'
    assign secondary_label = 'Etiketi kontrol edin'
    assign secondary_link = '/products/vitacoral-glucomannan-60-sase'
  endif
-%}

{%- unless cart == empty -%}
  <section class="vc-cart-assist" id="VCCartAssist-{{ section.id }}">
    <div class="page-width">
      <div class="vc-cart-assist__shell">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="vc-cart-assist__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2>{{ assist_title | escape }}</h2>
          <p>{{ assist_body | escape }}</p>
        </div>
        <div class="vc-cart-assist__actions">
          {%- if primary_label != blank and primary_link != blank -%}
            <a class="vc-cart-assist__primary" href="{{ primary_link }}">{{ primary_label | escape }}</a>
          {%- endif -%}
          {%- if secondary_label != blank and secondary_link != blank -%}
            <a class="vc-cart-assist__secondary" href="{{ secondary_link }}">{{ secondary_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endunless -%}

<style>
  .vc-cart-assist{padding:0 0 1.2rem;background:linear-gradient(180deg,rgba(247,250,249,.9),#fff)}.vc-cart-assist__shell{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1.2rem;align-items:center;padding:1.35rem;border:.1rem solid rgba(34,89,82,.12);border-radius:1.8rem;background:radial-gradient(circle at 94% 0%,rgba(208,168,94,.2),transparent 28%),#fff;box-shadow:0 .9rem 2.2rem rgba(21,44,41,.055)}.vc-cart-assist__eyebrow{margin:0 0 .35rem;color:#d0a85e;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:.92rem;font-weight:950;letter-spacing:.14em;text-transform:uppercase}.vc-cart-assist h2{margin:0;color:#16312e;font-family:var(--vitacoral-font-brand,"Gibbs Book",Arial,sans-serif);font-size:clamp(2rem,3vw,2.8rem);font-weight:650;letter-spacing:-.04em;line-height:1.05}.vc-cart-assist p{max-width:62rem;margin:.55rem 0 0;color:rgba(22,49,46,.74);font-size:1.08rem;line-height:1.48}.vc-cart-assist__actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.55rem}.vc-cart-assist__primary,.vc-cart-assist__secondary{display:inline-flex;align-items:center;justify-content:center;min-height:3.9rem;padding:.82rem 1.05rem;border-radius:999px;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:1rem;font-weight:900;text-decoration:none;white-space:nowrap}.vc-cart-assist__primary{background:#225952;color:#fff}.vc-cart-assist__secondary{border:.1rem solid rgba(34,89,82,.18);background:rgba(34,89,82,.06);color:#225952}@media screen and (max-width:749px){.vc-cart-assist{padding:0 0 .85rem}.vc-cart-assist .page-width{padding-left:1.6rem;padding-right:1.6rem}.vc-cart-assist__shell{grid-template-columns:1fr;gap:.95rem;padding:1.05rem;border-radius:1.45rem;box-shadow:0 .65rem 1.4rem rgba(21,44,41,.045)}.vc-cart-assist h2{font-size:2rem}.vc-cart-assist p{font-size:.98rem;line-height:1.44}.vc-cart-assist__actions{justify-content:flex-start}.vc-cart-assist__primary,.vc-cart-assist__secondary{min-height:3.45rem;padding:.72rem .9rem;font-size:.92rem}}
</style>

{% schema %}
{
  "name": "Sepet rutin desteği",
  "tag": "section",
  "class": "section",
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Rutin desteği"},
    {"type":"text","id":"heading","label":"Başlık","default":"Rutininizi tamamlayın"},
    {"type":"textarea","id":"body","label":"Açıklama","default":"Sepetinizdeki ürünü günlük rutininiz içinde birlikte düşünebileceğiniz seçeneklerle tamamlayabilirsiniz."},
    {"type":"text","id":"primary_label","label":"Birincil CTA","default":"Rutinleri incele"},
    {"type":"url","id":"primary_link","label":"Birincil link"},
    {"type":"text","id":"secondary_label","label":"İkincil CTA","default":"Tüm ürünler"},
    {"type":"url","id":"secondary_link","label":"İkincil link"}
  ],
  "presets": [{"name":"Sepet rutin desteği"}]
}
{% endschema %}
