<section class="vc-doc-hub" id="VCDocHub-{{ section.id }}">
  <div class="page-width">
    <div class="vc-doc-hub__hero">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vc-doc-hub__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1>{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="vc-doc-hub__body rte">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="vc-doc-hub__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign document_url = ''
            if block.settings.file_picker != blank
              assign document_url = block.settings.file_picker | file_url
            elsif block.settings.file_link != blank
              assign document_url = block.settings.file_link
            endif
          -%}
          <article class="vc-doc-hub__card" role="listitem" {{ block.shopify_attributes }}>
            {%- if block.settings.category != blank -%}
              <p class="vc-doc-hub__category">{{ block.settings.category | escape }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h2>{{ block.settings.title | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="vc-doc-hub__card-body rte">{{ block.settings.body }}</div>
            {%- endif -%}
            {%- if document_url != blank -%}
              <a class="vc-doc-hub__link" href="{{ document_url }}" target="_blank" rel="noopener">
                {{ block.settings.link_label | default: 'Belgeyi aç' | escape }}
              </a>
            {%- else -%}
              <span class="vc-doc-hub__empty">Dosya linki eklenecek</span>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .vc-doc-hub{padding:clamp(2rem,4vw,4.8rem) 0;background:linear-gradient(180deg,#fff,rgba(247,250,249,.9))}.vc-doc-hub__hero{max-width:82rem;margin:0 auto 1.4rem;text-align:center}.vc-doc-hub__eyebrow{margin:0 0 .7rem;color:#225952;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:1rem;font-weight:950;letter-spacing:.16em;text-transform:uppercase}.vc-doc-hub h1{margin:0;color:var(--vitacoral-color-text,#16312e);font-family:var(--vitacoral-font-brand,"Gibbs Book",Arial,sans-serif);font-size:clamp(3rem,5vw,5.4rem);font-weight:650;letter-spacing:-.045em;line-height:1}.vc-doc-hub__body{max-width:66rem;margin:1rem auto 0;color:rgba(22,49,46,.76);font-size:1.28rem;line-height:1.58}.vc-doc-hub__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.9rem;margin-top:1.8rem}.vc-doc-hub__card{display:grid;align-content:start;gap:.68rem;min-height:18rem;padding:1.25rem;border:.1rem solid rgba(34,89,82,.11);border-radius:1.65rem;background:rgba(255,255,255,.9);box-shadow:0 .9rem 2.2rem rgba(21,44,41,.045)}.vc-doc-hub__category{margin:0;color:#d0a85e;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:.95rem;font-weight:950;letter-spacing:.12em;text-transform:uppercase}.vc-doc-hub__card h2{margin:0;color:#16312e;font-family:var(--vitacoral-font-brand,"Gibbs Book",Arial,sans-serif);font-size:1.75rem;font-weight:650;letter-spacing:-.03em;line-height:1.08}.vc-doc-hub__card-body{margin:0;color:rgba(22,49,46,.75);font-size:1.05rem;line-height:1.5}.vc-doc-hub__link,.vc-doc-hub__empty{align-self:end;justify-self:start;margin-top:.3rem;padding:.68rem .95rem;border-radius:999px;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:.96rem;font-weight:900;text-decoration:none}.vc-doc-hub__link{background:#225952;color:#fff}.vc-doc-hub__empty{border:.1rem solid rgba(34,89,82,.14);background:rgba(34,89,82,.06);color:#225952}@media screen and (max-width:989px){.vc-doc-hub__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media screen and (max-width:749px){.vc-doc-hub{padding:1.6rem 0 2.2rem}.vc-doc-hub .page-width{padding-left:1.6rem;padding-right:1.6rem}.vc-doc-hub__hero{text-align:left}.vc-doc-hub h1{font-size:3.1rem}.vc-doc-hub__body{font-size:1.08rem;line-height:1.5}.vc-doc-hub__grid{grid-template-columns:1fr;gap:.65rem;margin-top:1.1rem}.vc-doc-hub__card{min-height:0;padding:1.05rem;border-radius:1.35rem;box-shadow:none}.vc-doc-hub__card h2{font-size:1.5rem}.vc-doc-hub__card-body{font-size:1rem}}
</style>

{% schema %}
{
  "name": "Belge merkezi",
  "tag": "section",
  "class": "section",
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Belge merkezi"},
    {"type":"text","id":"heading","label":"Başlık","default":"Belgeleri inceleyin"},
    {"type":"richtext","id":"body","label":"Açıklama","default":"<p>Ürün ve kalite belgelerini tek yerden inceleyebilirsiniz. Dosya linkleri Shopify Files üzerinden güncellenebilir.</p>"}
  ],
  "blocks": [
    {
      "type": "document_card",
      "name": "Belge kartı",
      "settings": [
        {"type":"text","id":"category","label":"Kategori","default":"Kalite"},
        {"type":"text","id":"title","label":"Belge adı","default":"Belge adı"},
        {"type":"richtext","id":"body","label":"Kısa açıklama","default":"<p>Bu kartın dosya linki Shopify Files üzerinden eklenecektir.</p>"},
        {"type":"file","id":"file_picker","label":"Belge dosyası"},
        {"type":"url","id":"file_link","label":"Manuel dosya linki"},
        {"type":"text","id":"link_label","label":"CTA etiketi","default":"Belgeyi aç"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Belge merkezi",
      "blocks": [
        {"type":"document_card","settings":{"category":"Kalite","title":"GMP","body":"<p>İyi üretim uygulamaları belgesi için dosya linki eklenecek.</p>"}},
        {"type":"document_card","settings":{"category":"Kalite","title":"HACCP","body":"<p>Gıda güvenliği ve kritik kontrol süreçlerine dair belge linki eklenecek.</p>"}},
        {"type":"document_card","settings":{"category":"Kalite","title":"ISO 9001","body":"<p>Kalite yönetim sistemi belgesi için dosya linki eklenecek.</p>"}}
      ]
    }
  ]
}
{% endschema %}
