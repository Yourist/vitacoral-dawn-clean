{%- liquid
  assign primary_cta_link = section.settings.primary_cta_link
  assign secondary_cta_link = section.settings.secondary_cta_link
-%}

<section
  class="vitacoral-editorial-media vitacoral-editorial-media--{{ section.settings.layout_style | default: 'split' }} vitacoral-section"
  id="VitacoralEditorialMedia-{{ section.id }}"
>
  <div class="vitacoral-container">
    <div class="vitacoral-editorial-media__shell">
      <div class="vitacoral-editorial-media__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vitacoral-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="vitacoral-heading-lg">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="vitacoral-body vitacoral-editorial-media__body rte">
            {{ section.settings.body }}
          </div>
        {%- endif -%}

        {%- if section.settings.primary_cta_label != blank or section.settings.secondary_cta_label != blank -%}
          <div class="vitacoral-editorial-media__actions">
            {%- if section.settings.primary_cta_label != blank -%}
              <a
                {% if primary_cta_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ primary_cta_link }}"
                {% endif %}
                class="vitacoral-button"
              >
                {{ section.settings.primary_cta_label | escape }}
              </a>
            {%- endif -%}

            {%- if section.settings.secondary_cta_label != blank -%}
              <a
                {% if secondary_cta_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ secondary_cta_link }}"
                {% endif %}
                class="vitacoral-button vitacoral-button--secondary"
              >
                {{ section.settings.secondary_cta_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- assign media_alt = section.settings.heading | default: section.settings.eyebrow | strip_html | escape -%}
      <div class="vitacoral-editorial-media__visual">
        <div class="vitacoral-editorial-media__frame">
          {%- if section.settings.video_url != blank -%}
            {%- if section.settings.fallback_image != blank -%}
              <div class="vitacoral-editorial-media__fallback-layer" aria-hidden="true">
                {{
                  section.settings.fallback_image
                  | image_url: width: 1600
                  | image_tag:
                    widths: '375, 550, 750, 900, 1200, 1600',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    loading: 'lazy',
                    alt: '',
                    class: 'vitacoral-editorial-media__image'
                }}
              </div>
            {%- endif -%}
            <video
              class="vitacoral-editorial-media__video"
              playsinline
              preload="metadata"
              {% if section.settings.autoplay %}
                autoplay
              {% endif %}
              {% if section.settings.loop %}
                loop
              {% endif %}
              {% if section.settings.muted %}
                muted
              {% endif %}
              {% if section.settings.video_poster_image != blank %}
                poster="{{ section.settings.video_poster_image | image_url: width: 1600 }}"
              {% endif %}
            >
              <source src="{{ section.settings.video_url }}" type="video/mp4">
              {{ media_alt }}
            </video>
          {%- elsif section.settings.fallback_image != blank -%}
            {{
              section.settings.fallback_image
              | image_url: width: 1600
              | image_tag:
                widths: '375, 550, 750, 900, 1200, 1600',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'lazy',
                alt: media_alt,
                class: 'vitacoral-editorial-media__image'
            }}
          {%- else -%}
            <div class="vitacoral-editorial-media__placeholder" aria-hidden="true">
              <span class="vitacoral-editorial-media__placeholder-chip">Vitacoral</span>
              <div class="vitacoral-editorial-media__placeholder-card">
                <span class="vitacoral-editorial-media__placeholder-mark"></span>
                <p class="vitacoral-heading-lg">İçerikleri ve ürün seçeneklerini daha görsel bir akışta inceleyin.</p>
                <p class="vitacoral-body-muted">Video ya da görsel ekleyerek bu alanı modern bir marka katmanına dönüştürebilirsiniz.</p>
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.media_caption != blank -%}
          <p class="vitacoral-body-muted vitacoral-editorial-media__caption">
            {{ section.settings.media_caption | escape }}
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral editorial media",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Vitacoral yaklaşımı"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Ürün seçimini sadeleştiren bir rehberlik"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Vitacoral’de içerik, kullanım ve etiket bilgilerini daha anlaşılır bir akışta sunmaya odaklanıyoruz.</p>"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "split",
      "options": [
        {
          "value": "split",
          "label": "split"
        },
        {
          "value": "full_bleed_card",
          "label": "full_bleed_card"
        },
        {
          "value": "stacked_mobile",
          "label": "stacked_mobile"
        }
      ]
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary CTA label",
      "default": "Rutinini bul"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary CTA label",
      "default": "Tüm ürünleri gör"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA link"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Fallback image"
    },
    {
      "type": "image_picker",
      "id": "video_poster_image",
      "label": "Video poster image"
    },
    {
      "type": "text",
      "id": "media_caption",
      "label": "Media caption"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Muted",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Vitacoral editorial media"
    }
  ]
}
{% endschema %}