<section class="vc-contact-info section" id="VcContactInfo-{{ section.id }}">
  {%- style -%}
    #VcContactInfo-{{ section.id }} {
      padding: clamp(1rem, 2.4vw, 2.4rem) 0 clamp(1.4rem, 3vw, 3rem);
    }

    #VcContactInfo-{{ section.id }} .vc-contact-info__grid {
      display: grid;
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 1.2rem;
    }

    #VcContactInfo-{{ section.id }} .vc-contact-info__card {
      position: relative;
      overflow: hidden;
      display: grid;
      gap: 0.8rem;
      padding: 1.8rem;
      min-height: 100%;
      background:
        radial-gradient(circle at top right, rgba(34, 89, 82, 0.08), transparent 38%),
        linear-gradient(180deg, rgba(255, 255, 255, 1), rgba(248, 250, 249, 0.96));
      border: 0.1rem solid rgba(34, 89, 82, 0.1);
      border-radius: var(--vitacoral-radius-lg, 1.8rem);
      box-shadow: 0 1.2rem 2.8rem rgba(21, 44, 41, 0.055);
    }

    #VcContactInfo-{{ section.id }} .vc-contact-info__card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 0.42rem;
      background: linear-gradient(90deg, rgba(34, 89, 82, 0.88), rgba(236, 101, 66, 0.78));
      opacity: 0.72;
    }

    #VcContactInfo-{{ section.id }} .vc-contact-info__label {
      display: inline-flex;
      width: fit-content;
      padding: 0.48rem 0.9rem;
      color: var(--vitacoral-color-primary-deep, #163d38);
      font-family: var(--vitacoral-font-ui);
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      line-height: 1;
      text-transform: uppercase;
      background: rgba(255, 255, 255, 0.74);
      border: 0.1rem solid rgba(34, 89, 82, 0.12);
      border-radius: var(--vitacoral-radius-pill, 999px);
    }

    #VcContactInfo-{{ section.id }} .vc-contact-info__title {
      margin: 0;
      color: var(--vitacoral-color-text);
      font-family: var(--vitacoral-font-brand);
      font-size: 2rem;
      font-weight: 650;
      letter-spacing: -0.035em;
      line-height: 1.1;
    }

    #VcContactInfo-{{ section.id }} .vc-contact-info__text,
    #VcContactInfo-{{ section.id }} .vc-contact-info__link {
      margin: 0;
      color: var(--vitacoral-color-text-muted);
      font-family: var(--vitacoral-font-body);
      font-size: 1.48rem;
      line-height: 1.58;
    }

    #VcContactInfo-{{ section.id }} .vc-contact-info__link {
      width: fit-content;
      color: var(--vitacoral-color-primary-deep, #163d38);
      font-weight: 800;
      text-decoration-color: rgba(236, 101, 66, 0.42);
      text-underline-offset: 0.25rem;
    }

    #VcContactInfo-{{ section.id }} .vc-contact-info__link:hover {
      color: #ec6542;
    }

    @media screen and (min-width: 750px) {
      #VcContactInfo-{{ section.id }} .vc-contact-info__grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #VcContactInfo-{{ section.id }} .vc-contact-info__card {
        padding: 1.55rem;
      }
    }
  {%- endstyle -%}

  <div class="page-width page-width--narrow">
    <div class="vc-contact-info__grid">
      {%- for block in section.blocks -%}
        <article class="vc-contact-info__card" {{ block.shopify_attributes }}>
          {%- if block.settings.label != blank -%}
            <span class="vc-contact-info__label">{{ block.settings.label | escape }}</span>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h2 class="vc-contact-info__title">{{ block.settings.title | escape }}</h2>
          {%- endif -%}

          {%- if block.settings.link_url != blank and block.settings.text != blank -%}
            <a class="vc-contact-info__link" href="{{ block.settings.link_url }}">{{ block.settings.text | escape }}</a>
          {%- elsif block.settings.text != blank -%}
            <p class="vc-contact-info__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral Contact Info",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "info_card",
      "name": "Info card",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "İletişim"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Başlık"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "İletişim bilgisi"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Optional link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Vitacoral Contact Info",
      "blocks": [
        { "type": "info_card" },
        { "type": "info_card" },
        { "type": "info_card" }
      ]
    }
  ]
}
{% endschema %}
