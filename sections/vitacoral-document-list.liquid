<section class="vc-document-list section" id="VcDocumentList-{{ section.id }}">
  {%- style -%}
    #VcDocumentList-{{ section.id }} {
      padding: clamp(1.4rem, 3vw, 2.6rem) 0 clamp(2.8rem, 4.5vw, 5.2rem);
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__layout {
      display: grid;
      gap: clamp(1.8rem, 3vw, 2.8rem);
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__intro {
      position: relative;
      max-width: 74rem;
      display: grid;
      gap: 1rem;
      padding-left: 1.6rem;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__intro::before {
      content: '';
      position: absolute;
      top: 0.25rem;
      bottom: 0.25rem;
      left: 0;
      width: 0.35rem;
      border-radius: 999px;
      background: linear-gradient(180deg, #225952, #ec6542);
      opacity: 0.78;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__eyebrow {
      margin: 0;
      color: var(--vitacoral-color-primary);
      font-family: var(--vitacoral-font-ui);
      font-size: 1.12rem;
      font-weight: 800;
      letter-spacing: 0.17em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__heading {
      margin: 0;
      color: var(--vitacoral-color-text);
      font-family: var(--vitacoral-font-brand);
      font-size: clamp(2.5rem, 4vw, 4rem);
      font-weight: 650;
      letter-spacing: -0.04em;
      line-height: 1.04;
      text-wrap: balance;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__body {
      color: var(--vitacoral-color-text-muted);
      font-family: var(--vitacoral-font-body);
      font-size: 1.62rem;
      line-height: 1.68;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__body > *:first-child {
      margin-top: 0;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__body > *:last-child {
      margin-bottom: 0;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__items {
      display: grid;
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 1.4rem;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__card {
      position: relative;
      overflow: hidden;
      display: grid;
      grid-template-rows: auto auto 1fr auto;
      gap: 1rem;
      height: 100%;
      padding: 2rem;
      background:
        radial-gradient(circle at top right, rgba(34, 89, 82, 0.08), transparent 38%),
        linear-gradient(180deg, rgba(255, 255, 255, 1), rgba(248, 250, 249, 0.96));
      border: 0.1rem solid rgba(34, 89, 82, 0.1);
      border-radius: var(--vitacoral-radius-lg);
      box-shadow: 0 1.2rem 2.8rem rgba(21, 44, 41, 0.055);
      transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 0.45rem;
      background: linear-gradient(90deg, rgba(34, 89, 82, 0.88), rgba(236, 101, 66, 0.78));
      opacity: 0.72;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__card::after {
      content: '';
      position: absolute;
      right: -3rem;
      bottom: -3rem;
      width: 9rem;
      height: 9rem;
      border-radius: 999px;
      background: rgba(236, 101, 66, 0.055);
      pointer-events: none;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__card:hover {
      transform: translateY(-0.25rem);
      border-color: rgba(34, 89, 82, 0.18);
      box-shadow: 0 1.6rem 3.4rem rgba(21, 44, 41, 0.08);
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__meta {
      position: relative;
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      align-items: center;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__category {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.9rem;
      padding: 0.5rem 1rem;
      color: var(--vitacoral-color-primary-deep, #163d38);
      font-family: var(--vitacoral-font-ui);
      font-size: 1.06rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      line-height: 1;
      text-transform: uppercase;
      background: rgba(255, 255, 255, 0.74);
      border: 0.1rem solid rgba(34, 89, 82, 0.12);
      border-radius: var(--vitacoral-radius-pill);
      box-shadow: 0 0.5rem 1.3rem rgba(21, 44, 41, 0.04);
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__title {
      position: relative;
      z-index: 1;
      margin: 0;
      color: var(--vitacoral-color-text);
      font-family: var(--vitacoral-font-brand);
      font-size: 2.08rem;
      font-weight: 650;
      letter-spacing: -0.035em;
      line-height: 1.08;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__description {
      position: relative;
      z-index: 1;
      margin: 0;
      color: var(--vitacoral-color-text-muted);
      font-family: var(--vitacoral-font-body);
      font-size: 1.52rem;
      line-height: 1.64;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__link,
    #VcDocumentList-{{ section.id }} .vc-document-list__link-placeholder {
      position: relative;
      z-index: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.65rem;
      width: fit-content;
      min-height: 3.8rem;
      margin-top: 0.2rem;
      padding: 0.72rem 1rem;
      color: var(--vitacoral-color-primary-deep, #163d38);
      font-family: var(--vitacoral-font-ui);
      font-size: 1.34rem;
      font-weight: 800;
      line-height: 1.2;
      text-decoration: none;
      background: rgba(255, 255, 255, 0.72);
      border: 0.1rem solid rgba(34, 89, 82, 0.12);
      border-radius: var(--vitacoral-radius-pill);
      transition: color 160ms ease, border-color 160ms ease, background 160ms ease, transform 160ms ease;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__link::after {
      content: '→';
      color: #ec6542;
      line-height: 1;
      transition: transform 160ms ease;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__link:hover {
      color: var(--vitacoral-color-primary);
      background: rgba(255, 255, 255, 0.94);
      border-color: rgba(236, 101, 66, 0.24);
      transform: translateY(-0.1rem);
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__link:hover::after {
      transform: translateX(0.2rem);
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__link-placeholder {
      color: rgba(34, 89, 82, 0.58);
      background: rgba(255, 255, 255, 0.46);
      border-style: dashed;
      cursor: default;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__link-placeholder::after {
      content: 'yakında';
      color: rgba(236, 101, 66, 0.72);
      font-size: 1.05rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #VcDocumentList-{{ section.id }} .vc-document-list__empty {
      padding: 1.8rem;
      color: var(--vitacoral-color-text-muted);
      background: rgba(255, 255, 255, 0.9);
      border: 0.1rem dashed rgba(34, 89, 82, 0.14);
      border-radius: var(--vitacoral-radius-lg);
      text-align: center;
    }

    @media screen and (min-width: 750px) {
      #VcDocumentList-{{ section.id }} .vc-document-list__items {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #VcDocumentList-{{ section.id }} .vc-document-list__intro {
        padding-left: 1.2rem;
      }

      #VcDocumentList-{{ section.id }} .vc-document-list__card,
      #VcDocumentList-{{ section.id }} .vc-document-list__empty {
        padding: 1.6rem;
      }

      #VcDocumentList-{{ section.id }} .vc-document-list__heading {
        font-size: 2.35rem;
      }

      #VcDocumentList-{{ section.id }} .vc-document-list__card:hover {
        transform: none;
      }
    }
  {%- endstyle -%}

  <div class="page-width page-width--narrow">
    <div class="vc-document-list__layout">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.body != blank -%}
        <div class="vc-document-list__intro">
          {%- if section.settings.eyebrow != blank -%}
            <p class="vc-document-list__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="vc-document-list__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <div class="vc-document-list__body rte">
              {{ section.settings.body }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="vc-document-list__items" role="list">
          {%- for block in section.blocks -%}
            <article class="vc-document-list__card" role="listitem" {{ block.shopify_attributes }}>
              <div class="vc-document-list__meta">
                {%- if block.settings.category != blank -%}
                  <span class="vc-document-list__category">{{ block.settings.category | escape }}</span>
                {%- endif -%}
              </div>

              {%- if block.settings.title != blank -%}
                <h3 class="vc-document-list__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="vc-document-list__description">{{ block.settings.description | escape }}</p>
              {%- endif -%}

              {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
                <a href="{{ block.settings.link_url }}" class="vc-document-list__link">
                  {{ block.settings.link_label | escape }}
                </a>
              {%- elsif block.settings.link_label != blank -%}
                <span class="vc-document-list__link-placeholder" aria-disabled="true">
                  {{ block.settings.link_label | escape }}
                </span>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      {%- elsif request.design_mode -%}
        <div class="vc-document-list__empty">
          Document/link cards can be added here from the Theme Editor.
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral Document List",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Vitacoral belgeleri"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Belge ve kaynak başlıkları"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    }
  ],
  "blocks": [
    {
      "type": "document_item",
      "name": "Document item",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Optional category"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Document title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Optional link label",
          "default": "Belgeyi görüntüle"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Optional file or link"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Vitacoral Document List",
      "blocks": [
        {
          "type": "document_item"
        },
        {
          "type": "document_item"
        },
        {
          "type": "document_item"
        }
      ]
    }
  ]
}
{% endschema %}
