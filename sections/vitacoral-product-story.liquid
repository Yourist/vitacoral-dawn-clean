{{ 'vitacoral-product-story-polish.css' | asset_url | stylesheet_tag }}

<section class="vitacoral-product-story vitacoral-section" id="VitacoralProductStory-{{ section.id }}">
  <div class="vitacoral-container">
    <div class="vitacoral-product-story__shell">
      <div class="vitacoral-product-story__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vitacoral-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="vitacoral-heading-lg">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="vitacoral-body vitacoral-product-story__body rte">
            {{ section.settings.body }}
          </div>
        {%- endif -%}

        {%- if section.settings.primary_cta_label != blank or section.settings.secondary_cta_label != blank -%}
          <div class="vitacoral-product-story__actions">
            {%- if section.settings.primary_cta_label != blank -%}
              <a
                {% if section.settings.primary_cta_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.primary_cta_link }}"
                {% endif %}
                class="vitacoral-button"
              >
                {{ section.settings.primary_cta_label | escape }}
              </a>
            {%- endif -%}

            {%- if section.settings.secondary_cta_label != blank -%}
              <a
                {% if section.settings.secondary_cta_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.secondary_cta_link }}"
                {% endif %}
                class="vitacoral-button vitacoral-button--secondary"
              >
                {{ section.settings.secondary_cta_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="vitacoral-product-story__grid" role="list">
          {%- for block in section.blocks -%}
            <article class="vitacoral-product-story__card vitacoral-card" role="listitem" {{ block.shopify_attributes }}>
              {%- if block.settings.badge != blank -%}
                <p class="vitacoral-product-story__badge">{{ block.settings.badge | escape }}</p>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="vitacoral-product-story__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.body != blank -%}
                <div class="vitacoral-body vitacoral-product-story__card-body rte">
                  {{ block.settings.body }}
                </div>
              {%- endif -%}

              {%- if block.settings.link_label != blank -%}
                <a
                  {% if block.settings.link_url == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.link_url }}"
                  {% endif %}
                  class="vitacoral-product-story__link"
                >
                  {{ block.settings.link_label | escape }}
                </a>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral product story",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "VITACORAL YAKLAŞIMI"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Ürün bilgilerini daha rahat okuyun"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>İçerik, kullanım, belge ve alışveriş bilgilerini aynı akış içinde sade şekilde inceleyin.</p>"
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary CTA label",
      "default": "Kalite belgeleri"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary CTA label",
      "default": "Hammadde belgeleri"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA link"
    }
  ],
  "blocks": [
    {
      "type": "story_card",
      "name": "Story card",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Vitacoral product story",
      "blocks": [
        {
          "type": "story_card",
          "settings": {
            "badge": "01",
            "title": "İçerik bilgisi",
            "body": "<p>Ürünü başlığıyla değil; içerik yapısı, ürün formu ve kullanım bilgisiyle birlikte değerlendirin.</p>"
          }
        },
        {
          "type": "story_card",
          "settings": {
            "badge": "02",
            "title": "Kullanım kolaylığı",
            "body": "<p>Saşe, kapsül veya tablet formunu günlük kullanım alışkanlığınıza göre daha rahat karşılaştırın.</p>"
          }
        },
        {
          "type": "story_card",
          "settings": {
            "badge": "03",
            "title": "Belge şeffaflığı",
            "body": "<p>Bakanlık onayı, kalite belgeleri ve hammadde sertifikaları gibi güven unsurlarını görünür tutarız.</p>"
          }
        },
        {
          "type": "story_card",
          "settings": {
            "badge": "04",
            "title": "Doğru kanallar",
            "body": "<p>Resmi web mağazası ve yetkili satış kanalları üzerinden ürün ve alışveriş sürecini daha net takip edebilirsiniz.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}