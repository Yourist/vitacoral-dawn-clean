{%- liquid
  assign richtext_heading = section.settings.heading | strip
  assign has_page_content = false
  if page and page.content != blank
    assign has_page_content = true
  endif
-%}

<section class="vc-page-richtext section" id="VcPageRichtext-{{ section.id }}">
  {%- style -%}
    #VcPageRichtext-{{ section.id }} {
      padding: 0 0 clamp(3rem, 4.5vw, 5.4rem);
    }

    #VcPageRichtext-{{ section.id }} .vc-page-richtext__surface {
      position: relative;
      overflow: hidden;
      padding: clamp(2rem, 3.4vw, 3.4rem);
      background:
        radial-gradient(circle at top left, rgba(236, 101, 66, 0.1), transparent 34%),
        radial-gradient(circle at bottom right, rgba(34, 89, 82, 0.1), transparent 42%),
        linear-gradient(135deg, rgba(255, 255, 255, 0.99), rgba(247, 250, 249, 0.95));
      border: 0.1rem solid rgba(34, 89, 82, 0.1);
      border-radius: var(--vitacoral-radius-xl, 2.4rem);
      box-shadow: 0 1.2rem 3rem rgba(21, 44, 41, 0.06);
    }

    #VcPageRichtext-{{ section.id }} .vc-page-richtext__surface::before {
      content: '';
      position: absolute;
      inset: 0 auto 0 0;
      width: 0.5rem;
      background: linear-gradient(180deg, #225952, #ec6542);
      opacity: 0.75;
    }

    #VcPageRichtext-{{ section.id }} .vc-page-richtext__surface::after {
      content: '';
      position: absolute;
      right: -3.6rem;
      top: -3.6rem;
      width: 11rem;
      height: 11rem;
      border-radius: 999px;
      background: rgba(236, 101, 66, 0.06);
      pointer-events: none;
    }

    #VcPageRichtext-{{ section.id }} .vc-page-richtext__heading,
    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content {
      position: relative;
      z-index: 1;
      max-width: 76rem;
    }

    #VcPageRichtext-{{ section.id }} .vc-page-richtext__heading {
      margin: 0 0 1.5rem;
      color: var(--vitacoral-color-text);
      font-family: var(--vitacoral-font-brand);
      font-size: clamp(2.3rem, 3vw, 3.4rem);
      font-weight: 650;
      letter-spacing: -0.04em;
      line-height: 1.06;
      text-wrap: balance;
    }

    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content {
      color: var(--vitacoral-color-text);
      font-family: var(--vitacoral-font-body);
    }

    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content > *:first-child {
      margin-top: 0;
    }

    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content > *:last-child {
      margin-bottom: 0;
    }

    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content p,
    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content li,
    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content td,
    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content th {
      color: var(--vitacoral-color-text-muted);
      font-family: var(--vitacoral-font-body);
      font-size: 1.64rem;
      line-height: 1.72;
    }

    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content p + p {
      margin-top: 1.25rem;
    }

    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content h2,
    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content h3,
    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content h4,
    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content h5,
    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content h6 {
      margin: 2.4rem 0 1rem;
      color: var(--vitacoral-color-text);
      font-family: var(--vitacoral-font-brand);
      font-weight: 650;
      letter-spacing: -0.035em;
      line-height: 1.1;
    }

    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content a {
      color: var(--vitacoral-color-primary-deep, #163d38);
      font-weight: 700;
      text-decoration-color: rgba(236, 101, 66, 0.5);
      text-underline-offset: 0.25rem;
    }

    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content img,
    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content iframe,
    #VcPageRichtext-{{ section.id }} .vc-page-richtext__content video {
      display: block;
      max-width: 100%;
      height: auto;
      border-radius: var(--vitacoral-radius-lg);
      box-shadow: 0 1rem 2.4rem rgba(21, 44, 41, 0.06);
    }

    @media screen and (max-width: 749px) {
      #VcPageRichtext-{{ section.id }} .vc-page-richtext__surface {
        padding: 1.6rem 1.4rem 1.6rem 1.7rem;
        border-radius: var(--vitacoral-radius-lg);
      }

      #VcPageRichtext-{{ section.id }} .vc-page-richtext__surface::before {
        width: 0.38rem;
      }

      #VcPageRichtext-{{ section.id }} .vc-page-richtext__content p,
      #VcPageRichtext-{{ section.id }} .vc-page-richtext__content li,
      #VcPageRichtext-{{ section.id }} .vc-page-richtext__content td,
      #VcPageRichtext-{{ section.id }} .vc-page-richtext__content th {
        font-size: 1.5rem;
        line-height: 1.62;
      }
    }
  {%- endstyle -%}

  <div class="page-width page-width--narrow">
    <div class="vc-page-richtext__surface">
      {%- if richtext_heading != blank -%}
        <h2 class="vc-page-richtext__heading">{{ richtext_heading | escape }}</h2>
      {%- endif -%}

      <div class="vc-page-richtext__content rte">
        {%- if section.settings.body != blank -%}
          {{ section.settings.body }}
        {%- elsif has_page_content -%}
          {{ page.content }}
        {%- elsif request.design_mode -%}
          <p>Add rich text here or use the page body content.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral Page Richtext",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Optional heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body override",
      "info": "Leave blank to use the page body content."
    }
  ],
  "presets": [
    {
      "name": "Vitacoral Page Richtext"
    }
  ]
}
{% endschema %}
