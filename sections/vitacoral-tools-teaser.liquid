{{ 'vitacoral-tools-teaser.css' | asset_url | stylesheet_tag }}
{{ 'vitacoral-audit-fixes.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign tools_cta_link = section.settings.cta_link
  if tools_cta_link == blank
    assign tools_cta_link = '/pages/saglik-hesaplama-araclari'
  endif
-%}

<section class="vc-tools-teaser" id="VitacoralToolsTeaser-{{ section.id }}">
  <div class="page-width vc-tools-teaser__inner">
    <div class="vc-tools-teaser__copy">
      <p class="vc-tools-teaser__eyebrow">Günlük hesaplama araçları</p>
      <h2 class="vc-tools-teaser__title">Kendinize dair temel değerleri tek yerde görün</h2>
      <div class="vc-tools-teaser__body rte"><p>Kalori, VKİ, kilo aralığı, su ve protein ihtiyacınızı yaklaşık olarak hesaplayın; ardından size uygun Vitacoral rutinini bulun.</p></div>
      <div class="vc-tools-teaser__actions"><a class="vc-tools-teaser__button" href="{{ tools_cta_link }}">Araçları aç</a></div>
    </div>

    <div class="vc-tools-teaser__panel" aria-label="Sağlık hesaplama araçları">
      {%- assign tool_titles = 'Günlük kalori ihtiyacı|Vücut kitle indeksi|İdeal kilo aralığı|Günlük su ihtiyacı|Protein ihtiyacı|Rutinini bul' | split: '|' -%}
      {%- assign tool_texts = 'Yaklaşık günlük enerji ihtiyacınızı görün.|Boy ve kilonuza göre VKİ değerinizi hesaplayın.|Boyunuza göre genel referans aralığını görün.|Kilo ve aktivite düzeyinize göre su ihtiyacınızı hesaplayın.|Kilo ve hareket düzeyinize göre protein miktarını görün.|Kısa seçimlerle size en yakın rutin sayfasına ulaşın.' | split: '|' -%}
      {%- for tool_title in tool_titles -%}
        <div class="vc-tools-teaser__mini">
          <span class="vc-tools-teaser__icon">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div><h3 class="vc-tools-teaser__mini-title">{{ tool_title }}</h3><p class="vc-tools-teaser__mini-text">{{ tool_texts[forloop.index0] }}</p></div>
        </div>
      {%- endfor -%}
      <p class="vc-tools-teaser__note">Sonuçlar genel bilgilendirme amaçlı yaklaşık değerlerdir.</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Araçlar teaser",
  "tag": "section",
  "class": "section",
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type":"url","id":"cta_link","label":"Araçlar sayfası bağlantısı"}
  ],
  "presets": [{"name":"Araçlar teaser"}]
}
{% endschema %}