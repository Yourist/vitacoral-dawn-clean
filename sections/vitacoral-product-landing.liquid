<section class="vc-product-landing section" id="VcProductLanding-{{ section.id }}">
  {%- style -%}
    #VcProductLanding-{{ section.id }} {
      padding: clamp(1.6rem, 3vw, 3rem) 0 clamp(3rem, 5vw, 6rem);
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__stack {
      display: grid;
      gap: clamp(1.4rem, 2.6vw, 2.6rem);
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__hero {
      position: relative;
      overflow: hidden;
      display: grid;
      gap: clamp(2rem, 3vw, 3rem);
      align-items: center;
      padding: clamp(2.2rem, 4.5vw, 4.4rem);
      background:
        radial-gradient(circle at 8% 8%, rgba(236, 101, 66, 0.16), transparent 30%),
        radial-gradient(circle at 86% 10%, rgba(34, 89, 82, 0.14), transparent 34%),
        linear-gradient(135deg, rgba(255, 255, 255, 0.99), rgba(246, 250, 248, 0.95));
      border: 0.1rem solid rgba(34, 89, 82, 0.1);
      border-radius: var(--vitacoral-radius-xl, 2.4rem);
      box-shadow: 0 1.8rem 4.2rem rgba(21, 44, 41, 0.065);
      isolation: isolate;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__hero::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: min(22rem, 50%);
      background: linear-gradient(90deg, rgba(34, 89, 82, 0.12), rgba(236, 101, 66, 0.1), transparent 74%);
      opacity: 0.74;
      mask-image: linear-gradient(180deg, #000, transparent);
      z-index: -1;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__hero-content {
      display: grid;
      gap: 1.15rem;
      max-width: 70rem;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__eyebrow,
    #VcProductLanding-{{ section.id }} .vc-product-landing__label {
      display: inline-flex;
      align-items: center;
      gap: 0.68rem;
      width: fit-content;
      margin: 0;
      padding: 0.58rem 1rem;
      color: var(--vitacoral-color-primary-deep, #163d38);
      font-family: var(--vitacoral-font-ui);
      font-size: 1.08rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      line-height: 1;
      text-transform: uppercase;
      background: rgba(255, 255, 255, 0.76);
      border: 0.1rem solid rgba(34, 89, 82, 0.12);
      border-radius: var(--vitacoral-radius-pill, 999px);
      box-shadow: 0 0.6rem 1.6rem rgba(21, 44, 41, 0.045);
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__eyebrow::before,
    #VcProductLanding-{{ section.id }} .vc-product-landing__label::before {
      content: '';
      width: 0.6rem;
      height: 0.6rem;
      border-radius: 999px;
      background: #ec6542;
      box-shadow: 0 0 0 0.35rem rgba(236, 101, 66, 0.12);
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__title {
      max-width: 13ch;
      margin: 0;
      color: var(--vitacoral-color-text);
      font-family: var(--vitacoral-font-brand);
      font-size: clamp(3.2rem, 6vw, 6rem);
      font-weight: 650;
      letter-spacing: -0.055em;
      line-height: 0.96;
      text-wrap: balance;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__body {
      max-width: 64rem;
      color: var(--vitacoral-color-text-muted);
      font-family: var(--vitacoral-font-body);
      font-size: 1.68rem;
      line-height: 1.68;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__body > *:first-child { margin-top: 0; }
    #VcProductLanding-{{ section.id }} .vc-product-landing__body > *:last-child { margin-bottom: 0; }

    #VcProductLanding-{{ section.id }} .vc-product-landing__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.9rem;
      align-items: center;
      margin-top: 0.4rem;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__button,
    #VcProductLanding-{{ section.id }} .vc-product-landing__button-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 4.8rem;
      padding: 0.9rem 1.5rem;
      font-family: var(--vitacoral-font-ui);
      font-size: 1.4rem;
      font-weight: 800;
      line-height: 1.2;
      text-decoration: none;
      border-radius: var(--vitacoral-radius-pill, 999px);
      transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__button {
      color: #fff;
      background: var(--vitacoral-color-primary, #225952);
      box-shadow: 0 1rem 2.2rem rgba(21, 44, 41, 0.14);
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__button-secondary {
      color: var(--vitacoral-color-primary-deep, #163d38);
      background: rgba(255, 255, 255, 0.78);
      border: 0.1rem solid rgba(34, 89, 82, 0.14);
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__button:hover,
    #VcProductLanding-{{ section.id }} .vc-product-landing__button-secondary:hover {
      transform: translateY(-0.12rem);
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__hero-card {
      position: relative;
      overflow: hidden;
      display: grid;
      gap: 1rem;
      padding: clamp(1.5rem, 2.4vw, 2.2rem);
      background: rgba(255, 255, 255, 0.76);
      border: 0.1rem solid rgba(34, 89, 82, 0.1);
      border-radius: var(--vitacoral-radius-xl, 2.4rem);
      box-shadow: 0 1rem 2.8rem rgba(21, 44, 41, 0.07);
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__image {
      overflow: hidden;
      border-radius: var(--vitacoral-radius-lg, 1.8rem);
      background: linear-gradient(135deg, rgba(246, 250, 248, 0.95), rgba(255, 255, 255, 0.98));
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__image img {
      display: block;
      width: 100%;
      height: auto;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__hero-note {
      margin: 0;
      color: var(--vitacoral-color-text-muted);
      font-family: var(--vitacoral-font-body);
      font-size: 1.4rem;
      line-height: 1.55;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__section {
      position: relative;
      display: grid;
      gap: 1.4rem;
      padding: clamp(1.8rem, 3vw, 3rem);
      background:
        radial-gradient(circle at top right, rgba(34, 89, 82, 0.07), transparent 36%),
        linear-gradient(180deg, rgba(255, 255, 255, 1), rgba(248, 250, 249, 0.96));
      border: 0.1rem solid rgba(34, 89, 82, 0.1);
      border-radius: var(--vitacoral-radius-xl, 2.4rem);
      box-shadow: 0 1.2rem 2.8rem rgba(21, 44, 41, 0.055);
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__section-heading {
      margin: 0;
      color: var(--vitacoral-color-text);
      font-family: var(--vitacoral-font-brand);
      font-size: clamp(2.4rem, 3.5vw, 4rem);
      font-weight: 650;
      letter-spacing: -0.045em;
      line-height: 1.04;
      text-wrap: balance;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__section-body {
      max-width: 72rem;
      color: var(--vitacoral-color-text-muted);
      font-family: var(--vitacoral-font-body);
      font-size: 1.58rem;
      line-height: 1.68;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__section-body > *:first-child { margin-top: 0; }
    #VcProductLanding-{{ section.id }} .vc-product-landing__section-body > *:last-child { margin-bottom: 0; }

    #VcProductLanding-{{ section.id }} .vc-product-landing__cards {
      display: grid;
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 1.2rem;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__mini-card {
      position: relative;
      overflow: hidden;
      padding: 1.6rem;
      background: rgba(255, 255, 255, 0.78);
      border: 0.1rem solid rgba(34, 89, 82, 0.1);
      border-radius: var(--vitacoral-radius-lg, 1.8rem);
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__mini-card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 0.38rem;
      background: linear-gradient(90deg, rgba(34, 89, 82, 0.86), rgba(236, 101, 66, 0.76));
      opacity: 0.72;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__mini-title {
      margin: 0 0 0.6rem;
      color: var(--vitacoral-color-text);
      font-family: var(--vitacoral-font-brand);
      font-size: 2rem;
      font-weight: 650;
      letter-spacing: -0.035em;
      line-height: 1.1;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__mini-text {
      margin: 0;
      color: var(--vitacoral-color-text-muted);
      font-family: var(--vitacoral-font-body);
      font-size: 1.48rem;
      line-height: 1.62;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__trust-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__trust-link {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      min-height: 3.8rem;
      padding: 0.75rem 1rem;
      color: var(--vitacoral-color-primary-deep, #163d38);
      font-family: var(--vitacoral-font-ui);
      font-size: 1.32rem;
      font-weight: 800;
      line-height: 1.2;
      text-decoration: none;
      background: rgba(255, 255, 255, 0.78);
      border: 0.1rem solid rgba(34, 89, 82, 0.12);
      border-radius: var(--vitacoral-radius-pill, 999px);
    }

    #VcProductLanding-{{ section.id }} .vc-product-landing__trust-link::after {
      content: '→';
      color: #ec6542;
      line-height: 1;
    }

    @media screen and (min-width: 900px) {
      #VcProductLanding-{{ section.id }} .vc-product-landing__hero {
        grid-template-columns: minmax(0, 1.05fr) minmax(30rem, 0.75fr);
      }

      #VcProductLanding-{{ section.id }} .vc-product-landing__cards {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #VcProductLanding-{{ section.id }} {
        padding-top: 1.4rem;
      }

      #VcProductLanding-{{ section.id }} .vc-product-landing__hero,
      #VcProductLanding-{{ section.id }} .vc-product-landing__section {
        border-radius: var(--vitacoral-radius-lg, 1.8rem);
      }

      #VcProductLanding-{{ section.id }} .vc-product-landing__hero {
        padding: 1.7rem 1.4rem;
      }

      #VcProductLanding-{{ section.id }} .vc-product-landing__title {
        max-width: 12ch;
        font-size: clamp(2.8rem, 9.8vw, 4.1rem);
      }

      #VcProductLanding-{{ section.id }} .vc-product-landing__body,
      #VcProductLanding-{{ section.id }} .vc-product-landing__section-body {
        font-size: 1.5rem;
        line-height: 1.62;
      }
    }
  {%- endstyle -%}

  <div class="page-width">
    <div class="vc-product-landing__stack">
      <div class="vc-product-landing__hero">
        <div class="vc-product-landing__hero-content">
          {%- if section.settings.eyebrow != blank -%}
            <p class="vc-product-landing__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h1 class="vc-product-landing__title">{{ section.settings.title | escape }}</h1>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <div class="vc-product-landing__body rte">{{ section.settings.body }}</div>
          {%- endif -%}
          <div class="vc-product-landing__actions">
            {%- if section.settings.primary_link != blank and section.settings.primary_label != blank -%}
              <a class="vc-product-landing__button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a>
            {%- endif -%}
            {%- if section.settings.secondary_link != blank and section.settings.secondary_label != blank -%}
              <a class="vc-product-landing__button-secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
            {%- endif -%}
          </div>
        </div>

        <div class="vc-product-landing__hero-card">
          {%- if section.settings.image != blank -%}
            <div class="vc-product-landing__image">
              {{ section.settings.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 34vw, 100vw', loading: 'lazy' }}
            </div>
          {%- endif -%}
          {%- if section.settings.hero_note != blank -%}
            <p class="vc-product-landing__hero-note">{{ section.settings.hero_note | escape }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'content_section' -%}
            <div class="vc-product-landing__section" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                <p class="vc-product-landing__label">{{ block.settings.label | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="vc-product-landing__section-heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="vc-product-landing__section-body rte">{{ block.settings.body }}</div>
              {%- endif -%}
            </div>
          {%- when 'card_grid' -%}
            <div class="vc-product-landing__section" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                <p class="vc-product-landing__label">{{ block.settings.label | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="vc-product-landing__section-heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              <div class="vc-product-landing__cards">
                {%- for i in (1..3) -%}
                  {%- liquid
                    assign title_key = 'card_' | append: i | append: '_title'
                    assign text_key = 'card_' | append: i | append: '_text'
                    assign card_title = block.settings[title_key]
                    assign card_text = block.settings[text_key]
                  -%}
                  {%- if card_title != blank or card_text != blank -%}
                    <article class="vc-product-landing__mini-card">
                      {%- if card_title != blank -%}<h3 class="vc-product-landing__mini-title">{{ card_title | escape }}</h3>{%- endif -%}
                      {%- if card_text != blank -%}<p class="vc-product-landing__mini-text">{{ card_text | escape }}</p>{%- endif -%}
                    </article>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- when 'trust_links' -%}
            <div class="vc-product-landing__section" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                <p class="vc-product-landing__label">{{ block.settings.label | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="vc-product-landing__section-heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="vc-product-landing__section-body rte">{{ block.settings.body }}</div>
              {%- endif -%}
              <div class="vc-product-landing__trust-links">
                {%- if block.settings.link_1_url != blank and block.settings.link_1_label != blank -%}
                  <a class="vc-product-landing__trust-link" href="{{ block.settings.link_1_url }}">{{ block.settings.link_1_label | escape }}</a>
                {%- endif -%}
                {%- if block.settings.link_2_url != blank and block.settings.link_2_label != blank -%}
                  <a class="vc-product-landing__trust-link" href="{{ block.settings.link_2_url }}">{{ block.settings.link_2_label | escape }}</a>
                {%- endif -%}
                {%- if block.settings.link_3_url != blank and block.settings.link_3_label != blank -%}
                  <a class="vc-product-landing__trust-link" href="{{ block.settings.link_3_url }}">{{ block.settings.link_3_label | escape }}</a>
                {%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral Product Landing",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Vitacoral" },
    { "type": "text", "id": "title", "label": "Title", "default": "Ürün ailesi landing" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "image_picker", "id": "image", "label": "Optional image" },
    { "type": "text", "id": "hero_note", "label": "Hero note" },
    { "type": "text", "id": "primary_label", "label": "Primary CTA label", "default": "Ürünleri incele" },
    { "type": "url", "id": "primary_link", "label": "Primary CTA link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary CTA label", "default": "Vitacoral yaklaşımı" },
    { "type": "url", "id": "secondary_link", "label": "Secondary CTA link" }
  ],
  "blocks": [
    {
      "type": "content_section",
      "name": "Content section",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    },
    {
      "type": "card_grid",
      "name": "Three card grid",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "card_1_title", "label": "Card 1 title" },
        { "type": "textarea", "id": "card_1_text", "label": "Card 1 text" },
        { "type": "text", "id": "card_2_title", "label": "Card 2 title" },
        { "type": "textarea", "id": "card_2_text", "label": "Card 2 text" },
        { "type": "text", "id": "card_3_title", "label": "Card 3 title" },
        { "type": "textarea", "id": "card_3_text", "label": "Card 3 text" }
      ]
    },
    {
      "type": "trust_links",
      "name": "Trust links",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "body", "label": "Body" },
        { "type": "text", "id": "link_1_label", "label": "Link 1 label" },
        { "type": "url", "id": "link_1_url", "label": "Link 1 URL" },
        { "type": "text", "id": "link_2_label", "label": "Link 2 label" },
        { "type": "url", "id": "link_2_url", "label": "Link 2 URL" },
        { "type": "text", "id": "link_3_label", "label": "Link 3 label" },
        { "type": "url", "id": "link_3_url", "label": "Link 3 URL" }
      ]
    }
  ],
  "presets": [
    { "name": "Vitacoral Product Landing" }
  ]
}
{% endschema %}
