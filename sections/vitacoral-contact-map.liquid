<section class="vc-contact-map section" id="VcContactMap-{{ section.id }}">
  {%- style -%}
    #VcContactMap-{{ section.id }} {
      padding: 0 0 clamp(3rem, 4.5vw, 5.4rem);
    }

    #VcContactMap-{{ section.id }} .vc-contact-map__surface {
      position: relative;
      overflow: hidden;
      padding: clamp(1.3rem, 2.2vw, 2rem);
      background:
        radial-gradient(circle at top left, rgba(236, 101, 66, 0.1), transparent 34%),
        linear-gradient(135deg, rgba(255, 255, 255, 0.99), rgba(247, 250, 249, 0.95));
      border: 0.1rem solid rgba(34, 89, 82, 0.1);
      border-radius: var(--vitacoral-radius-xl, 2.4rem);
      box-shadow: 0 1.2rem 3rem rgba(21, 44, 41, 0.06);
    }

    #VcContactMap-{{ section.id }} .vc-contact-map__header {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.2rem;
    }

    #VcContactMap-{{ section.id }} .vc-contact-map__title {
      margin: 0;
      color: var(--vitacoral-color-text);
      font-family: var(--vitacoral-font-brand);
      font-size: clamp(2rem, 2.6vw, 2.8rem);
      font-weight: 650;
      letter-spacing: -0.04em;
      line-height: 1.06;
    }

    #VcContactMap-{{ section.id }} .vc-contact-map__link {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      width: fit-content;
      min-height: 3.7rem;
      padding: 0.72rem 1rem;
      color: var(--vitacoral-color-primary-deep, #163d38);
      font-family: var(--vitacoral-font-ui);
      font-size: 1.32rem;
      font-weight: 800;
      line-height: 1.2;
      text-decoration: none;
      background: rgba(255, 255, 255, 0.76);
      border: 0.1rem solid rgba(34, 89, 82, 0.12);
      border-radius: var(--vitacoral-radius-pill, 999px);
    }

    #VcContactMap-{{ section.id }} .vc-contact-map__link::after {
      content: '→';
      color: #ec6542;
      line-height: 1;
    }

    #VcContactMap-{{ section.id }} .vc-contact-map__frame {
      overflow: hidden;
      min-height: clamp(28rem, 42vw, 44rem);
      border-radius: var(--vitacoral-radius-lg, 1.8rem);
      border: 0.1rem solid rgba(34, 89, 82, 0.1);
      background: rgba(255, 255, 255, 0.8);
    }

    #VcContactMap-{{ section.id }} iframe {
      display: block;
      width: 100%;
      height: clamp(28rem, 42vw, 44rem);
      border: 0;
    }
  {%- endstyle -%}

  <div class="page-width page-width--narrow">
    <div class="vc-contact-map__surface">
      <div class="vc-contact-map__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="vc-contact-map__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.map_link != blank -%}
          <a class="vc-contact-map__link" href="{{ section.settings.map_link }}" target="_blank" rel="noopener noreferrer">
            Haritada görüntüle
          </a>
        {%- endif -%}
      </div>
      <div class="vc-contact-map__frame">
        <iframe
          src="{{ section.settings.embed_url }}"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="{{ section.settings.heading | default: 'Vitacoral adres haritası' | escape }}"
        ></iframe>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral Contact Map",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Adresimiz"
    },
    {
      "type": "url",
      "id": "map_link",
      "label": "Google Maps link"
    },
    {
      "type": "text",
      "id": "embed_url",
      "label": "Google Maps embed URL",
      "default": "https://www.google.com/maps?q=Hasanpa%C5%9Fa%20Mahallesi%20Lavanta%20Sokak%20Etap%20%C4%B0%C5%9F%20Merkezi%20C%20Blok%20Kat%3A3%20Daire%3A10%20Kad%C4%B1k%C3%B6y%20%C4%B0stanbul&output=embed"
    }
  ],
  "presets": [
    {
      "name": "Vitacoral Contact Map"
    }
  ]
}
{% endschema %}
