{%- liquid
  assign video_media = nil
  for media in product.media
    if media.media_type == 'video' or media.media_type == 'external_video'
      assign video_media = media
      break
    endif
  endfor
-%}

{%- if video_media != nil -%}
  <section class="vc-product-video" id="VCProductVideo-{{ section.id }}">
    <div class="page-width">
      <div class="vc-product-video__shell">
        <div class="vc-product-video__copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="vc-product-video__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2>{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <div class="vc-product-video__body rte">{{ section.settings.body }}</div>
          {%- endif -%}
        </div>

        <div class="vc-product-video__media">
          <div class="vc-product-video__frame">
            {%- if video_media.media_type == 'video' -%}
              {{ video_media | video_tag: image_size: '900x', controls: true, muted: false, loop: false, class: 'vc-product-video__player' }}
            {%- else -%}
              {{ video_media | external_video_tag: class: 'vc-product-video__player' }}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

<style>
  .vc-product-video{padding:clamp(1.35rem,2.8vw,3rem) 0;background:linear-gradient(180deg,#fff,rgba(247,250,249,.74))}.vc-product-video__shell{display:grid;grid-template-columns:minmax(0,.92fr) minmax(22rem,.72fr);gap:1rem;align-items:center}.vc-product-video__copy{padding:1.35rem;border:.1rem solid rgba(34,89,82,.1);border-radius:1.65rem;background:linear-gradient(180deg,#fff,rgba(247,250,249,.78));box-shadow:0 .7rem 1.8rem rgba(21,44,41,.045)}.vc-product-video__eyebrow{margin:0 0 .54rem;color:#d0a85e;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:.82rem;font-weight:950;letter-spacing:.14em;line-height:1.1;text-transform:uppercase}.vc-product-video h2{margin:0;color:var(--vitacoral-color-text,#16312e);font-family:var(--vitacoral-font-brand,"Gibbs Book",Arial,sans-serif);font-size:clamp(2.05rem,3vw,3.12rem);font-weight:650;letter-spacing:-.045em;line-height:1.02}.vc-product-video__body{margin:.72rem 0 0;color:rgba(22,49,46,.72);font-size:1rem;line-height:1.48}.vc-product-video__body p{margin:0}.vc-product-video__media{display:flex;justify-content:center}.vc-product-video__frame{width:min(100%,24rem);aspect-ratio:9/16;overflow:hidden;border:.1rem solid rgba(34,89,82,.1);border-radius:1.75rem;background:#101c1a;box-shadow:0 1rem 2.4rem rgba(21,44,41,.12)}.vc-product-video__player{display:block;width:100%;height:100%;object-fit:contain;background:#101c1a}.vc-product-video__player iframe{width:100%;height:100%}@media screen and (max-width:989px){.vc-product-video__shell{grid-template-columns:1fr}.vc-product-video__media{justify-content:flex-start}.vc-product-video__frame{width:min(100%,22rem)}}@media screen and (max-width:749px){.vc-product-video{padding:1.05rem 0 1.35rem}.vc-product-video .page-width{padding-left:1.6rem;padding-right:1.6rem}.vc-product-video__shell{gap:.68rem}.vc-product-video__copy{padding:1rem;border-radius:1.35rem;box-shadow:none}.vc-product-video h2{font-size:2rem}.vc-product-video__body{font-size:.92rem;line-height:1.42}.vc-product-video__media{justify-content:center}.vc-product-video__frame{width:min(100%,20rem);border-radius:1.45rem;box-shadow:0 .75rem 1.8rem rgba(21,44,41,.1)}}
</style>

{% schema %}
{
  "name": "Product video",
  "tag": "section",
  "class": "section",
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Kutu açılışı"},
    {"type":"text","id":"heading","label":"Heading","default":"Kutu açılışı ve kullanım"},
    {"type":"richtext","id":"body","label":"Body","default":"<p>Ürünün kutu içeriğini, saşe formunu ve kullanım akışını kısa videoda inceleyin.</p>"}
  ],
  "presets": [{"name":"Product video"}]
}
{% endschema %}
