{%- liquid
  assign video_media = nil
  for media in product.media
    if media.media_type == 'video' or media.media_type == 'external_video'
      assign video_media = media
      break
    endif
  endfor
-%}

{%- if video_media != nil -%}
  <section class="vc-product-video" id="VCProductVideo-{{ section.id }}">
    <div class="page-width">
      <div class="vc-product-video__shell">
        <div class="vc-product-video__copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="vc-product-video__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2>{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <div class="vc-product-video__body rte">{{ section.settings.body }}</div>
          {%- endif -%}
        </div>

        <div class="vc-product-video__media">
          <div class="vc-product-video__frame">
            {%- if video_media.media_type == 'video' -%}
              {{ video_media | video_tag: image_size: '900x', controls: true, muted: false, loop: false, class: 'vc-product-video__player' }}
            {%- else -%}
              {{ video_media | external_video_tag: class: 'vc-product-video__player' }}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

<style>
  .vc-product-video{padding:clamp(1.2rem,2.5vw,2.7rem) 0;background:linear-gradient(180deg,#fff,rgba(247,250,249,.74))}.vc-product-video__shell{display:grid;grid-template-columns:minmax(0,.82fr) minmax(24rem,.82fr);gap:1rem;align-items:center}.vc-product-video__copy{padding:1.22rem;border:.1rem solid rgba(34,89,82,.1);border-radius:1.55rem;background:linear-gradient(180deg,#fff,rgba(247,250,249,.78));box-shadow:0 .7rem 1.8rem rgba(21,44,41,.045)}.vc-product-video__eyebrow{margin:0 0 .48rem;color:#d0a85e;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:.78rem;font-weight:950;letter-spacing:.14em;line-height:1.1;text-transform:uppercase}.vc-product-video h2{margin:0;color:var(--vitacoral-color-text,#16312e);font-family:var(--vitacoral-font-brand,"Gibbs Book",Arial,sans-serif);font-size:clamp(1.95rem,2.8vw,2.9rem);font-weight:650;letter-spacing:-.045em;line-height:1.02}.vc-product-video__body{margin:.62rem 0 0;color:rgba(22,49,46,.72);font-size:.96rem;line-height:1.45}.vc-product-video__body p{margin:0}.vc-product-video__media{display:flex;justify-content:center}.vc-product-video__frame{width:min(100%,28rem);aspect-ratio:9/16;overflow:hidden;border:.1rem solid rgba(34,89,82,.1);border-radius:1.55rem;background:#101c1a;box-shadow:0 1rem 2.4rem rgba(21,44,41,.12)}.vc-product-video__player{display:block;width:100%;height:100%;object-fit:contain;background:#101c1a}.vc-product-video__player iframe{width:100%;height:100%}@media screen and (max-width:989px){.vc-product-video__shell{grid-template-columns:1fr}.vc-product-video__media{justify-content:center}.vc-product-video__frame{width:min(100%,26rem)}}@media screen and (max-width:749px){.vc-product-video{padding:.9rem 0 1.2rem}.vc-product-video .page-width{padding-left:1.2rem;padding-right:1.2rem}.vc-product-video__shell{gap:.58rem}.vc-product-video__copy{padding:.82rem .9rem;border-radius:1.16rem;box-shadow:none}.vc-product-video h2{font-size:1.62rem;letter-spacing:-.035em}.vc-product-video__body{margin:.42rem 0 0;font-size:.82rem;line-height:1.34}.vc-product-video__eyebrow{font-size:.68rem;margin-bottom:.36rem}.vc-product-video__media{justify-content:center}.vc-product-video__frame{width:100%;max-width:none;border-radius:1.12rem;box-shadow:0 .75rem 1.8rem rgba(21,44,41,.1)}}
</style>

{% schema %}
{
  "name": "Product video",
  "tag": "section",
  "class": "section",
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Kutu açılışı"},
    {"type":"text","id":"heading","label":"Heading","default":"Kutu açılışı ve kullanım"},
    {"type":"richtext","id":"body","label":"Body","default":"<p>Ürünün kutu içeriğini, saşe formunu ve kullanım akışını kısa videoda inceleyin.</p>"}
  ],
  "presets": [{"name":"Product video"}]
}
{% endschema %}
