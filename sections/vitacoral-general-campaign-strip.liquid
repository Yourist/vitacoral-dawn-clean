{{ 'vitacoral-campaign-surfaces.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vitacoral-campaign-surfaces.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign campaign_enabled = section.settings.enabled
  assign campaign_badge = section.settings.badge | strip
  assign campaign_title = section.settings.title | strip
  assign campaign_code = section.settings.code | strip
  assign campaign_note = section.settings.note | strip
  assign campaign_link_label = section.settings.link_label | strip
  assign campaign_link = section.settings.link
-%}

{%- if campaign_enabled and campaign_title != blank -%}
  <section class="vc-general-campaign-strip vc-general-campaign-strip--{{ section.id }}" data-vc-campaign-surface>
    <style>
      .vc-general-campaign-strip--{{ section.id }} {
        padding: 0 1.5rem 1.2rem;
      }

      .vc-general-campaign-strip--{{ section.id }} .vc-general-campaign-strip__inner {
        display: grid;
        gap: 1rem;
        max-width: var(--page-width, 1200px);
        margin: 0 auto;
        padding: 1.2rem;
        border: 1px solid rgba(236, 101, 66, .18);
        border-radius: 22px;
        background: linear-gradient(135deg, rgba(255, 248, 244, .98), rgba(255, 255, 255, .98));
        box-shadow: 0 12px 32px rgba(54, 37, 26, .07);
      }

      .vc-general-campaign-strip--{{ section.id }} .vc-general-campaign-strip__copy {
        display: grid;
        gap: .35rem;
      }

      .vc-general-campaign-strip--{{ section.id }} .vc-general-campaign-strip__badge {
        width: fit-content;
        padding: .35rem .75rem;
        border-radius: 999px;
        background: #ec6542;
        color: #fff;
        font-size: 1.12rem;
        font-weight: 800;
      }

      .vc-general-campaign-strip--{{ section.id }} .vc-general-campaign-strip__title {
        margin: 0;
        font-size: clamp(1.65rem, 4vw, 2.2rem);
        line-height: 1.12;
        font-weight: 850;
      }

      .vc-general-campaign-strip--{{ section.id }} .vc-general-campaign-strip__note,
      .vc-general-campaign-strip--{{ section.id }} .vc-campaign-copy-feedback {
        margin: 0;
        color: rgba(var(--color-foreground), .68);
        font-size: 1.25rem;
        line-height: 1.35;
      }

      .vc-general-campaign-strip--{{ section.id }} .vc-general-campaign-strip__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .75rem;
      }

      .vc-general-campaign-strip--{{ section.id }} .vc-general-campaign-strip__code {
        display: inline-flex;
        align-items: center;
        min-height: 3.8rem;
        padding: 0 1rem;
        border-radius: 999px;
        background: rgba(236, 101, 66, .1);
        color: #ec6542;
        font-family: inherit;
        font-size: 1.3rem;
        font-weight: 900;
        letter-spacing: .03em;
      }

      .vc-general-campaign-strip--{{ section.id }} .vc-general-campaign-strip__link {
        display: inline-flex;
        align-items: center;
        min-height: 3.8rem;
        padding: 0 1.2rem;
        border-radius: 999px;
        background: rgba(236, 101, 66, .1);
        color: #ec6542;
        font-size: 1.18rem;
        font-weight: 850;
        text-decoration: none;
      }

      @media screen and (min-width: 750px) {
        .vc-general-campaign-strip--{{ section.id }} .vc-general-campaign-strip__inner {
          grid-template-columns: minmax(0, 1fr) auto;
          align-items: center;
          padding: 1.4rem 1.6rem;
        }

        .vc-general-campaign-strip--{{ section.id }} .vc-general-campaign-strip__actions {
          justify-content: flex-end;
        }
      }
    </style>

    <div class="vc-general-campaign-strip__inner">
      <div class="vc-general-campaign-strip__copy">
        {%- if campaign_badge != blank -%}
          <span class="vc-general-campaign-strip__badge">{{ campaign_badge | escape }}</span>
        {%- endif -%}
        <h2 class="vc-general-campaign-strip__title">{{ campaign_title | escape }}</h2>
        {%- if campaign_note != blank -%}
          <p class="vc-general-campaign-strip__note">{{ campaign_note | escape }}</p>
        {%- endif -%}
        <p class="vc-campaign-copy-feedback" hidden data-vc-copy-feedback aria-live="polite"></p>
      </div>

      <div class="vc-general-campaign-strip__actions">
        {%- if campaign_code != blank -%}
          <code class="vc-general-campaign-strip__code">{{ campaign_code | escape }}</code>
          <button class="vc-campaign-copy" type="button" data-vc-copy-code="{{ campaign_code | escape }}">Kopyala</button>
        {%- endif -%}
        {%- if campaign_link_label != blank and campaign_link != blank -%}
          <a class="vc-general-campaign-strip__link" href="{{ campaign_link }}">{{ campaign_link_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Genel kampanya strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"checkbox","id":"enabled","label":"Kampanyayı göster","default":true},
    {"type":"text","id":"badge","label":"Badge","default":"İlk sipariş"},
    {"type":"text","id":"title","label":"Başlık","default":"İlk siparişinize %10 indirim"},
    {"type":"text","id":"code","label":"Kod","default":"WELCOME10"},
    {"type":"text","id":"note","label":"Not","default":"Kodu ödeme adımında kullanabilirsiniz."},
    {"type":"text","id":"link_label","label":"Link etiketi","default":"Ürünleri incele"},
    {"type":"url","id":"link","label":"Link"}
  ],
  "presets": [
    {"name":"Genel kampanya strip"}
  ]
}
{% endschema %}
