<section class="vc-faq-list section" id="VcFaqList-{{ section.id }}">
  {%- style -%}
    #VcFaqList-{{ section.id }} {
      padding: clamp(1.4rem, 3vw, 2.6rem) 0 clamp(3rem, 4.5vw, 5.4rem);
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__layout {
      display: grid;
      gap: clamp(1.8rem, 3vw, 2.8rem);
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__intro {
      position: relative;
      max-width: 74rem;
      display: grid;
      gap: 1rem;
      padding-left: 1.6rem;
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__intro::before {
      content: '';
      position: absolute;
      top: 0.25rem;
      bottom: 0.25rem;
      left: 0;
      width: 0.35rem;
      border-radius: 999px;
      background: linear-gradient(180deg, #225952, #ec6542);
      opacity: 0.78;
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__eyebrow {
      margin: 0;
      color: var(--vitacoral-color-primary);
      font-family: var(--vitacoral-font-ui);
      font-size: 1.12rem;
      font-weight: 800;
      letter-spacing: 0.17em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__heading {
      margin: 0;
      color: var(--vitacoral-color-text);
      font-family: var(--vitacoral-font-brand);
      font-size: clamp(2.5rem, 4vw, 4rem);
      font-weight: 650;
      letter-spacing: -0.04em;
      line-height: 1.04;
      text-wrap: balance;
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__body {
      color: var(--vitacoral-color-text-muted);
      font-family: var(--vitacoral-font-body);
      font-size: 1.62rem;
      line-height: 1.68;
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__body > *:first-child { margin-top: 0; }
    #VcFaqList-{{ section.id }} .vc-faq-list__body > *:last-child { margin-bottom: 0; }

    #VcFaqList-{{ section.id }} .vc-faq-list__items {
      display: grid;
      gap: 1.1rem;
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__item {
      overflow: hidden;
      background:
        radial-gradient(circle at top right, rgba(34, 89, 82, 0.06), transparent 36%),
        linear-gradient(180deg, rgba(255, 255, 255, 1), rgba(248, 250, 249, 0.96));
      border: 0.1rem solid rgba(34, 89, 82, 0.1);
      border-radius: var(--vitacoral-radius-lg);
      box-shadow: 0 1rem 2.4rem rgba(21, 44, 41, 0.05);
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.2rem;
      padding: 1.6rem 1.8rem;
      color: var(--vitacoral-color-text);
      cursor: pointer;
      list-style: none;
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__summary::-webkit-details-marker {
      display: none;
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__question {
      font-family: var(--vitacoral-font-brand);
      font-size: 1.9rem;
      font-weight: 650;
      letter-spacing: -0.03em;
      line-height: 1.15;
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__icon {
      position: relative;
      flex: 0 0 auto;
      width: 3rem;
      height: 3rem;
      border-radius: 999px;
      background: rgba(236, 101, 66, 0.11);
      border: 0.1rem solid rgba(236, 101, 66, 0.18);
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__icon::before,
    #VcFaqList-{{ section.id }} .vc-faq-list__icon::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 1.1rem;
      height: 0.16rem;
      border-radius: 999px;
      background: #ec6542;
      transform: translate(-50%, -50%);
      transition: transform 160ms ease;
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__icon::after {
      transform: translate(-50%, -50%) rotate(90deg);
    }

    #VcFaqList-{{ section.id }} details[open] .vc-faq-list__icon::after {
      transform: translate(-50%, -50%) rotate(0deg);
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__answer {
      padding: 0 1.8rem 1.7rem;
      color: var(--vitacoral-color-text-muted);
      font-family: var(--vitacoral-font-body);
      font-size: 1.54rem;
      line-height: 1.66;
    }

    #VcFaqList-{{ section.id }} .vc-faq-list__answer > *:first-child { margin-top: 0; }
    #VcFaqList-{{ section.id }} .vc-faq-list__answer > *:last-child { margin-bottom: 0; }

    #VcFaqList-{{ section.id }} .vc-faq-list__empty {
      padding: 1.8rem;
      color: var(--vitacoral-color-text-muted);
      background: rgba(255, 255, 255, 0.9);
      border: 0.1rem dashed rgba(34, 89, 82, 0.14);
      border-radius: var(--vitacoral-radius-lg);
      text-align: center;
    }

    @media screen and (max-width: 749px) {
      #VcFaqList-{{ section.id }} .vc-faq-list__intro {
        padding-left: 1.2rem;
      }

      #VcFaqList-{{ section.id }} .vc-faq-list__heading {
        font-size: 2.35rem;
      }

      #VcFaqList-{{ section.id }} .vc-faq-list__summary {
        padding: 1.35rem 1.4rem;
      }

      #VcFaqList-{{ section.id }} .vc-faq-list__answer {
        padding: 0 1.4rem 1.4rem;
        font-size: 1.48rem;
        line-height: 1.62;
      }
    }
  {%- endstyle -%}

  <div class="page-width page-width--narrow">
    <div class="vc-faq-list__layout">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.body != blank -%}
        <div class="vc-faq-list__intro">
          {%- if section.settings.eyebrow != blank -%}
            <p class="vc-faq-list__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="vc-faq-list__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <div class="vc-faq-list__body rte">
              {{ section.settings.body }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="vc-faq-list__items">
          {%- for block in section.blocks -%}
            <details class="vc-faq-list__item" {{ block.shopify_attributes }}>
              <summary class="vc-faq-list__summary">
                <span class="vc-faq-list__question">{{ block.settings.question | escape }}</span>
                <span class="vc-faq-list__icon" aria-hidden="true"></span>
              </summary>

              {%- if block.settings.answer != blank -%}
                <div class="vc-faq-list__answer rte">
                  {{ block.settings.answer }}
                </div>
              {%- endif -%}
            </details>
          {%- endfor -%}
        </div>
      {%- elsif request.design_mode -%}
        <div class="vc-faq-list__empty">
          FAQ items can be added here from the Theme Editor.
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral FAQ List",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Yardım merkezi"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sıkça sorulan sorular"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Soru başlığı"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yanıt metni buraya eklenebilir.</p>"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Vitacoral FAQ List",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}
