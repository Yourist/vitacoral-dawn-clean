<section class="vitacoral-education vitacoral-section" id="VitacoralEducation-{{ section.id }}">
  <div class="vitacoral-container">
    <div class="vitacoral-education__header vitacoral-reveal is-visible">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vitacoral-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="vitacoral-heading-lg">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="vitacoral-body vitacoral-education__body rte">
          {{ section.settings.body }}
        </div>
      {%- endif -%}
    </div>

    <div class="vitacoral-education__carousel vitacoral-reveal is-visible">
      {%- if section.blocks.size > 0 -%}
        <ul class="vitacoral-education__grid list-unstyled" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign selected_article = block.settings.article
              assign card_title = block.settings.custom_title_override | strip
              if card_title == blank and selected_article != blank
                assign card_title = selected_article.title
              endif
              if card_title == blank
                assign card_title = 'Vitacoral yazısı'
              endif

              assign card_description = block.settings.custom_description | strip
              if card_description == blank and selected_article != blank
                assign card_description = selected_article.excerpt_or_content | strip_html | truncatewords: 20
              endif

              assign card_image = block.settings.custom_image_override
              if card_image == blank and selected_article != blank and selected_article.image != blank
                assign card_image = selected_article.image
              endif

              assign card_link = block.settings.cta_link
              if card_link == blank and selected_article != blank
                assign card_link = selected_article.url
              endif

              assign card_cta_label = block.settings.cta_label | strip
              if card_cta_label == blank
                assign card_cta_label = 'Yazıyı oku'
              endif

              assign card_image_alt = card_title
              if card_image != blank and card_image.alt != blank
                assign card_image_alt = card_image.alt
              endif
            -%}
            <li
              class="vitacoral-education__item vitacoral-education__item--{{ block.settings.accent_style }}"
              {{ block.shopify_attributes }}
            >
              <article class="vitacoral-education__card vitacoral-card">
                <div class="vitacoral-education__media-wrap">
                  {%- if block.settings.badge_text != blank -%}
                    <span class="vitacoral-chip vitacoral-education__badge">
                      {{ block.settings.badge_text | escape }}
                    </span>
                  {%- endif -%}

                  <div class="vitacoral-education__media">
                    {%- if card_image != blank -%}
                      {{
                        card_image
                        | image_url: width: 900
                        | image_tag:
                          widths: '320, 450, 660, 900',
                          sizes: '(min-width: 990px) 30vw, (min-width: 750px) 40vw, 78vw',
                          loading: 'lazy',
                          alt: card_image_alt,
                          class: 'vitacoral-education__image'
                      }}
                    {%- else -%}
                      <div class="vitacoral-education__placeholder" aria-hidden="true">
                        <span class="vitacoral-education__placeholder-mark"></span>
                        <span class="vitacoral-body-muted">{{ card_title | escape }}</span>
                      </div>
                    {%- endif -%}
                  </div>
                </div>

                <div class="vitacoral-education__content">
                  <h3 class="vitacoral-education__title">{{ card_title }}</h3>

                  {%- if card_description != blank -%}
                    <p class="vitacoral-body vitacoral-education__description">
                      {{ card_description | escape }}
                    </p>
                  {%- endif -%}
                </div>

                <div class="vitacoral-education__actions">
                  <a
                    {% if card_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ card_link }}"
                    {% endif %}
                    class="vitacoral-button{% if block.settings.accent_style == 'soft' %} vitacoral-button--secondary{% endif %}"
                  >
                    {{ card_cta_label | escape }}
                  </a>
                </div>
              </article>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="vitacoral-education__empty vitacoral-card">
          <p class="vitacoral-body-muted">Education cards can be added from the Theme Editor.</p>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.bottom_cta_label != blank -%}
      <div class="vitacoral-education__footer vitacoral-reveal is-visible">
        <a
          {% if section.settings.bottom_cta_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.bottom_cta_link }}"
          {% endif %}
          class="vitacoral-button vitacoral-button--secondary"
        >
          {{ section.settings.bottom_cta_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral Learn",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Öğren & Keşfet"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Günlük rutininizi daha bilinçli oluşturun"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Ürün aileleri, içerikler ve kullanım rutinleri hakkında sade bilgilerle seçim yapmayı kolaylaştırın.</p>"
    },
    {
      "type": "text",
      "id": "bottom_cta_label",
      "label": "Bottom CTA label",
      "default": "Tüm yazıları gör"
    },
    {
      "type": "url",
      "id": "bottom_cta_link",
      "label": "Bottom CTA link"
    }
  ],
  "blocks": [
    {
      "type": "education_item",
      "name": "Education item",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article picker"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text"
        },
        {
          "type": "text",
          "id": "custom_title_override",
          "label": "Custom title override"
        },
        {
          "type": "text",
          "id": "custom_description",
          "label": "Custom description"
        },
        {
          "type": "image_picker",
          "id": "custom_image_override",
          "label": "Custom image override"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Yazıyı oku"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA link"
        },
        {
          "type": "select",
          "id": "accent_style",
          "label": "Accent style",
          "default": "green",
          "options": [
            {
              "value": "green",
              "label": "green"
            },
            {
              "value": "orange",
              "label": "orange"
            },
            {
              "value": "soft",
              "label": "soft"
            }
          ]
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Vitacoral Learn",
      "blocks": [
        {
          "type": "education_item",
          "settings": {
            "badge_text": "Collagen",
            "custom_title_override": "Kolajen rutini nasıl düşünülmeli?",
            "custom_description": "Günlük bakım yaklaşımında kolajen ürünlerini nasıl konumlandırabileceğinizi keşfedin.",
            "cta_label": "Yazıyı oku",
            "accent_style": "orange"
          }
        },
        {
          "type": "education_item",
          "settings": {
            "badge_text": "Multivitamin",
            "custom_title_override": "Multivitamin seçerken nelere bakılır?",
            "custom_description": "Günlük kullanımda ürün bilgilerini daha anlaşılır şekilde karşılaştırmak için temel noktalar.",
            "cta_label": "Yazıyı oku",
            "accent_style": "green"
          }
        },
        {
          "type": "education_item",
          "settings": {
            "badge_text": "Rutin",
            "custom_title_override": "Size uygun ürünü seçmenin kolay yolu",
            "custom_description": "Ürün ailelerini ihtiyacınıza ve günlük alışkanlıklarınıza göre değerlendirin.",
            "cta_label": "Yazıyı oku",
            "accent_style": "soft"
          }
        }
      ]
    }
  ]
}
{% endschema %}
