{%- liquid
  assign title = 'Ürün dünyası'
  assign intro = 'Ürünü formu, içeriği ve kullanım deneyimiyle birlikte değerlendirin.'
  assign note_title = 'İçerik odağı'
  assign note_text = 'İçerik yapısını ve ürün formunu birlikte okuyun.'
  assign note_more = ''
  assign routine_title = 'Kullanım kolaylığı'
  assign routine_text = 'Ürünü günlük alışkanlıklarınıza nasıl ekleyebileceğinizi düşünün.'
  assign next_title = 'Karar desteği'
  assign next_text = 'Ürün bilgileri, belgeler ve kullanım detayları kararınızı netleştirir.'
  assign pill_1 = 'İçerik'
  assign pill_2 = 'Kullanım'
  assign pill_3 = 'Belgeler'
  assign micro_1 = ''
  assign micro_2 = ''
  assign micro_3 = ''
  assign cta_label = 'Ürün bilgilerine dön'
  assign cta_link = '#ProductInfo-' | append: section.id

  case product.handle
    when 'collagen-30-sase'
      assign title = 'Collagen deneyimi'
      assign intro = 'Tip 1-2-3 hidrolize kolajen, Beauty Blend ve 30 saşelik pratik formu birlikte sunar.'
      assign note_text = 'Bir saşede Tip 1, Tip 2 ve Tip 3 hidrolize kolajen birlikte yer alır. Formül; C Vitamini, Hyaluronik Asit, Alfa Lipoik Asit, Glutatyon, Çinko, Koenzim Q10, E Vitamini, B vitaminleri, Bakır, Biotin ve Selenyum ile birlikte değerlendirilir.'
      assign note_more = 'Beauty Blend tarafında Hyaluronic Acid, Alpha-Lipoic Acid, Coenzyme Q10 ve Vitamin C öne çıkar. Limon aromalı saşe form, porsiyon takibini kolaylaştırır.'
      assign routine_title = 'Günlük kullanım'
      assign routine_text = '30 saşelik yapı, günlük kullanım düzeninizi takip etmeyi kolaylaştırır. Tek porsiyonluk saşe formu, kolajen desteğini düzenli kullanıma uygun hale getirir.'
      assign next_text = 'Kullanım önerisi, belge bilgileri ve içerik detayları için aşağıdaki ürün bilgileri alanlarını inceleyebilirsiniz.'
      assign pill_1 = 'Tip 1-2-3'
      assign pill_2 = 'Beauty Blend'
      assign pill_3 = '30 saşe'
      assign micro_1 = 'C Vitamini'
      assign micro_2 = 'Hyaluronik Asit'
      assign micro_3 = 'Koenzim Q10'
    when 'multivitamin-for-women'
      assign title = 'Women multivitamin'
      assign intro = '11 vitamin, 8 mineral, Quali-C ve Premium Women Blend ile kadın günlük destek seçeneği sunar.'
      assign note_text = 'Formülde 11 vitamin ve 8 mineral bulunur. Quali-C patentli C vitamini ve Premium Women Blend, ürünün içerik odağını daha net okumanıza yardımcı olur.'
      assign note_more = 'Premium Women Blend; Lutein, Likopen, Yaban Mersini ve Alfa-Lipoik Asit içerikleriyle kadın günlük destek yaklaşımı içinde konumlanır.'
      assign routine_title = 'Günlük kullanım'
      assign routine_text = 'Multivitamin seçimini sadeleştirmek isteyenler için ürün formu, içerik yapısı ve kullanım önerisi birlikte değerlendirilmelidir.'
      assign next_text = 'Kullanım önerisi, içerik bilgisi ve ürün belgeleri için aşağıdaki ürün bilgileri alanlarını inceleyebilirsiniz.'
      assign pill_1 = '11 vitamin'
      assign pill_2 = '8 mineral'
      assign pill_3 = 'Women Blend'
      assign micro_1 = 'Quali-C'
      assign micro_2 = 'Lutein'
      assign micro_3 = 'Yaban Mersini'
    when 'multivitamin-for-men'
      assign title = 'Men multivitamin'
      assign intro = '11 vitamin, 8 mineral, Quali-C ve Premium Men Blend ile erkek günlük destek seçeneği sunar.'
      assign note_text = 'Formülde 11 vitamin ve 8 mineral bulunur. Quali-C patentli C vitamini ve Premium Men Blend, erkek multivitamin seçimini daha net okumanıza yardımcı olur.'
      assign note_more = 'Premium Men Blend; Lutein, Likopen, Isırgan Otu, Cüce Palmiye ve Beta-Glukan içerikleriyle erkek günlük destek yaklaşımı içinde konumlanır.'
      assign routine_title = 'Günlük kullanım'
      assign routine_text = 'Multivitamin seçimini sadeleştirmek isteyenler için ürün formu, içerik yapısı ve kullanım önerisi birlikte değerlendirilmelidir.'
      assign next_text = 'Kullanım önerisi, içerik bilgisi ve ürün belgeleri için aşağıdaki ürün bilgileri alanlarını inceleyebilirsiniz.'
      assign pill_1 = '11 vitamin'
      assign pill_2 = '8 mineral'
      assign pill_3 = 'Men Blend'
      assign micro_1 = 'Quali-C'
      assign micro_2 = 'Isırgan Otu'
      assign micro_3 = 'Beta-Glukan'
    when 'multivitamin-for-kids'
      assign title = 'Kids seçimi'
      assign intro = '13 vitamin, 10 mineral, Norveç balık yağı ve EPA/DHA içeriğiyle ebeveyn kararına odaklanır.'
      assign note_text = 'Formülde 13 vitamin, 10 mineral ve balık yağı bulunur. Balık yağı içeriği IFOS onaylı, Halal sertifikalı ve Norveç menşei olarak belirtilir.'
      assign note_more = 'EPA/DHA içeriği, doğal çilek aroması ve şekersiz form bilgisi ebeveynlerin ürün seçimini daha net değerlendirmesine yardımcı olur.'
      assign routine_title = 'Ebeveyn kontrolü'
      assign routine_text = 'Çocuk ürünlerinde yaş, kullanım önerisi ve uyarı bilgileri kararın önemli parçasıdır. Ürün ebeveyn kontrolünde değerlendirilmelidir.'
      assign next_text = 'Kullanım önerisi, içerik bilgisi ve uyarılar için aşağıdaki ürün bilgileri alanlarını inceleyebilirsiniz.'
      assign pill_1 = '13 vitamin'
      assign pill_2 = 'EPA / DHA'
      assign pill_3 = 'Şekersiz'
      assign micro_1 = '10 mineral'
      assign micro_2 = 'Norveç yağı'
      assign micro_3 = 'Çilek aroma'
    when 'vitacoral-glucomannan-60-sase'
      assign title = 'Lif odağı'
      assign intro = 'Konjac kaynaklı glucomannan, vanilya aromalı saşe form ve 60 saşelik kullanım düzeniyle öne çıkar.'
      assign note_text = 'Glucomannan, konjac bitkisinden elde edilen çözünür lif odağıdır. Ürün, lif içeriğini saşe formunda değerlendirmek isteyenler için konumlanır.'
      assign note_more = 'Bu üründe içerik kadar kullanım önerisi, su tüketimi ve uyarı bilgileri de önemlidir.'
      assign routine_title = 'Kullanım dikkati'
      assign routine_text = 'Glucomannan ürünlerinde kullanım önerisi ve su tüketimi bilgisi özellikle önemlidir. Ürün detaylarını birlikte değerlendirin.'
      assign next_text = 'Kullanım önerisi, içerik bilgisi ve uyarılar için aşağıdaki ürün bilgileri alanlarını inceleyebilirsiniz.'
      assign pill_1 = 'Konjac lif'
      assign pill_2 = '60 saşe'
      assign pill_3 = 'Vanilya'
      assign micro_1 = 'Çözünür lif'
      assign micro_2 = 'Su bilgisi'
      assign micro_3 = 'Kullanım önerisi'
  endcase

  if product.metafields.custom.pdp_world_title != blank
    assign title = product.metafields.custom.pdp_world_title.value
  endif
  if product.metafields.custom.pdp_world_intro != blank
    assign intro = product.metafields.custom.pdp_world_intro.value
  endif
  if product.metafields.custom.pdp_note_title != blank
    assign note_title = product.metafields.custom.pdp_note_title.value
  endif
  if product.metafields.custom.pdp_ingredient_note != blank
    assign note_text = product.metafields.custom.pdp_ingredient_note.value
  endif
  if product.metafields.custom.pdp_ingredient_more != blank
    assign note_more = product.metafields.custom.pdp_ingredient_more.value
  endif
  if product.metafields.custom.pdp_routine_title != blank
    assign routine_title = product.metafields.custom.pdp_routine_title.value
  endif
  if product.metafields.custom.pdp_routine_note != blank
    assign routine_text = product.metafields.custom.pdp_routine_note.value
  endif
  if product.metafields.custom.pdp_next_title != blank
    assign next_title = product.metafields.custom.pdp_next_title.value
  endif
  if product.metafields.custom.pdp_next_step != blank
    assign next_text = product.metafields.custom.pdp_next_step.value
  endif
  if product.metafields.custom.pdp_pill_1 != blank
    assign pill_1 = product.metafields.custom.pdp_pill_1.value
  endif
  if product.metafields.custom.pdp_pill_2 != blank
    assign pill_2 = product.metafields.custom.pdp_pill_2.value
  endif
  if product.metafields.custom.pdp_pill_3 != blank
    assign pill_3 = product.metafields.custom.pdp_pill_3.value
  endif
  if product.metafields.custom.pdp_micro_1 != blank
    assign micro_1 = product.metafields.custom.pdp_micro_1.value
  endif
  if product.metafields.custom.pdp_micro_2 != blank
    assign micro_2 = product.metafields.custom.pdp_micro_2.value
  endif
  if product.metafields.custom.pdp_micro_3 != blank
    assign micro_3 = product.metafields.custom.pdp_micro_3.value
  endif
  if product.metafields.custom.pdp_cta_label != blank
    assign cta_label = product.metafields.custom.pdp_cta_label.value
  endif
  if product.metafields.custom.pdp_cta_link != blank
    assign cta_link = product.metafields.custom.pdp_cta_link.value
  endif
-%}

<section class="vc-pdp-world" id="VCProductWorld-{{ section.id }}">
  <div class="page-width">
    <div class="vc-pdp-world__shell">
      <div class="vc-pdp-world__hero">
        <p class="vc-pdp-world__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ title | escape }}</h2>
        <p>{{ intro | escape }}</p>
        <div class="vc-pdp-world__pills" role="list">
          <span role="listitem">{{ pill_1 | escape }}</span>
          <span role="listitem">{{ pill_2 | escape }}</span>
          <span role="listitem">{{ pill_3 | escape }}</span>
        </div>
      </div>

      <div class="vc-pdp-world__cards">
        <article class="vc-pdp-world__lead">
          <span>01</span>
          <h3>{{ note_title | escape }}</h3>
          <p>{{ note_text | escape }}</p>
          {%- if note_more != blank -%}
            <p class="vc-pdp-world__more">{{ note_more | escape }}</p>
          {%- endif -%}
          {%- if micro_1 != blank or micro_2 != blank or micro_3 != blank -%}
            <ul>
              {%- if micro_1 != blank -%}<li>{{ micro_1 | escape }}</li>{%- endif -%}
              {%- if micro_2 != blank -%}<li>{{ micro_2 | escape }}</li>{%- endif -%}
              {%- if micro_3 != blank -%}<li>{{ micro_3 | escape }}</li>{%- endif -%}
            </ul>
          {%- endif -%}
        </article>

        <article>
          <span>02</span>
          <h3>{{ routine_title | escape }}</h3>
          <p>{{ routine_text | escape }}</p>
        </article>

        <article class="vc-pdp-world__next">
          <span>03</span>
          <h3>{{ next_title | escape }}</h3>
          <p>{{ next_text | escape }}</p>
          <a href="{{ cta_link }}">{{ cta_label | escape }}</a>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .vc-pdp-world{padding:clamp(1.7rem,3.4vw,4rem) 0;background:linear-gradient(180deg,#fff,rgba(247,250,249,.82))}.vc-pdp-world__shell{display:grid;grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr);gap:1rem;align-items:stretch}.vc-pdp-world__hero{position:relative;overflow:hidden;min-height:26rem;padding:1.8rem;border-radius:2.2rem;background:radial-gradient(circle at 82% 14%,rgba(217,182,111,.38),transparent 28%),linear-gradient(135deg,#143430,#225952 62%,#173c37);color:#fff;box-shadow:0 1.4rem 3.4rem rgba(21,44,41,.14)}.vc-pdp-world__hero:after{content:"";position:absolute;right:-5rem;bottom:-5rem;width:15rem;height:15rem;border:.1rem solid rgba(255,255,255,.18);border-radius:999px}.vc-pdp-world__eyebrow{margin:0 0 .62rem;color:rgba(255,255,255,.7);font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:.9rem;font-weight:900;letter-spacing:.16em;line-height:1.1;text-transform:uppercase}.vc-pdp-world h2{position:relative;max-width:13ch;margin:0;color:#fff;font-family:var(--vitacoral-font-brand,"Gibbs Book",Arial,sans-serif);font-size:clamp(2.8rem,4.4vw,4.55rem);font-weight:650;letter-spacing:-.045em;line-height:.99}.vc-pdp-world__hero p:not(.vc-pdp-world__eyebrow){position:relative;max-width:48rem;margin:1rem 0 0;color:rgba(255,255,255,.88);font-size:1.24rem;line-height:1.5}.vc-pdp-world__pills{position:relative;display:flex;flex-wrap:wrap;gap:.48rem;margin-top:1.12rem}.vc-pdp-world__pills span{display:inline-flex;align-items:center;min-height:2.42rem;padding:.4rem .72rem;border:.1rem solid rgba(255,255,255,.2);border-radius:999px;background:rgba(255,255,255,.12);color:#fff;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:.9rem;font-weight:850}.vc-pdp-world__cards{display:grid;grid-template-columns:1.2fr .86fr;grid-template-rows:1fr 1fr;gap:.85rem}.vc-pdp-world__cards article{display:grid;align-content:start;gap:.62rem;padding:1.22rem;border:.1rem solid rgba(34,89,82,.1);border-radius:1.65rem;background:rgba(255,255,255,.86);box-shadow:0 .9rem 2.2rem rgba(21,44,41,.045);backdrop-filter:blur(.4rem)}.vc-pdp-world__lead{grid-row:span 2;background:linear-gradient(180deg,#fff,rgba(248,250,249,.92))!important}.vc-pdp-world__cards span{color:#d0a85e;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:.86rem;font-weight:950;letter-spacing:.12em}.vc-pdp-world__cards h3{margin:0;color:var(--vitacoral-color-text,#16312e);font-family:var(--vitacoral-font-brand,"Gibbs Book",Arial,sans-serif);font-size:1.64rem;font-weight:650;letter-spacing:-.03em;line-height:1.08}.vc-pdp-world__cards p{margin:0;color:var(--vitacoral-color-text-muted,rgba(22,49,46,.76));font-size:1.02rem;line-height:1.48}.vc-pdp-world__more{color:rgba(22,49,46,.88)!important;font-weight:680}.vc-pdp-world__cards ul{display:flex;flex-wrap:wrap;gap:.38rem;margin:.12rem 0 0;padding:0;list-style:none}.vc-pdp-world__cards li{position:relative;padding:.34rem .58rem;border-radius:999px;background:rgba(34,89,82,.06);color:#225952;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:.88rem;font-weight:830}.vc-pdp-world__cards li:before{display:none}.vc-pdp-world__next{background:linear-gradient(180deg,rgba(34,89,82,.08),#fff)!important}.vc-pdp-world__next a{align-self:end;justify-self:start;margin-top:.15rem;padding:.64rem .92rem;border-radius:999px;background:#225952;color:#fff;text-decoration:none;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:.94rem;font-weight:900}@media screen and (max-width:989px){.vc-pdp-world__shell{grid-template-columns:1fr}.vc-pdp-world__hero{min-height:0}.vc-pdp-world__cards{grid-template-columns:1fr 1fr;grid-template-rows:auto}.vc-pdp-world__lead{grid-column:1/-1;grid-row:auto}.vc-pdp-world__next{grid-column:auto}}@media screen and (max-width:749px){.vc-pdp-world{padding:1.05rem 0 1.55rem}.vc-pdp-world .page-width{padding-left:1.6rem;padding-right:1.6rem}.vc-pdp-world__shell{gap:.68rem}.vc-pdp-world__hero{padding:1.22rem;border-radius:1.6rem;box-shadow:0 .9rem 2.2rem rgba(21,44,41,.13)}.vc-pdp-world h2{font-size:2.7rem}.vc-pdp-world__hero p:not(.vc-pdp-world__eyebrow){font-size:1.04rem;line-height:1.44}.vc-pdp-world__pills{gap:.38rem;margin-top:.88rem}.vc-pdp-world__pills span{min-height:2.12rem;padding:.32rem .56rem;font-size:.82rem}.vc-pdp-world__cards{grid-template-columns:1fr;gap:.58rem}.vc-pdp-world__cards article{padding:1rem;border-radius:1.35rem;box-shadow:none}.vc-pdp-world__cards h3{font-size:1.42rem}.vc-pdp-world__cards p{font-size:.94rem;line-height:1.43}.vc-pdp-world__cards ul{gap:.32rem}.vc-pdp-world__cards li{font-size:.82rem}.vc-pdp-world__next a{padding:.62rem .86rem;font-size:.88rem}}
</style>

{% schema %}
{
  "name": "PDP deneyim",
  "tag": "section",
  "class": "section",
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Ürün dünyası"}
  ],
  "presets": [{"name":"PDP deneyim"}]
}
{% endschema %}