      assign note_more = 'Quali-C ve Women Blend bilgisi, formülü yalnızca vitamin-mineral listesi olarak değil, kadın rutini odağıyla okumanıza yardımcı olur.'
      assign routine_text = 'Ürünü günlük alışkanlıklarınıza uygun bir başlangıç noktası olarak düşünebilirsiniz.'
      assign next_text = 'Kolajen seçeneğini aynı rutin içinde ayrıca değerlendirebilirsiniz.'
      assign pill_1 = '11 vitamin'
      assign pill_2 = '8 mineral'
      assign pill_3 = 'Women Blend'
      assign micro_1 = 'Quali-C'
      assign micro_2 = 'Vitaminler'
      assign micro_3 = 'Mineraller'
      assign cta_label = 'Rutini incele'
      assign cta_link = '/pages/kadin-gunluk-rutini'
    when 'multivitamin-for-men'
      assign title = 'Erkek rutini'
      assign intro = '11 vitamin, 8 mineral ve Men Blend içeriğiyle günlük destek seçiminizi daha net değerlendirin.'
      assign note_text = '11 vitamin ve 8 mineral içeriği, erkek günlük multivitamin seçimini tek formda değerlendirmenizi sağlar.'
      assign note_more = 'Quali-C ve Men Blend bilgisi, formülü yalnızca vitamin-mineral listesi olarak değil, erkek rutini odağıyla okumanıza yardımcı olur.'
      assign routine_text = 'Ürünü günlük alışkanlıklarınıza uygun bir başlangıç noktası olarak düşünebilirsiniz.'
      assign next_text = 'Kolajen seçeneğini aynı rutin içinde ayrıca değerlendirebilirsiniz.'
      assign pill_1 = '11 vitamin'
      assign pill_2 = '8 mineral'
      assign pill_3 = 'Men Blend'
      assign micro_1 = 'Quali-C'
      assign micro_2 = 'Vitaminler'
      assign micro_3 = 'Mineraller'
      assign cta_label = 'Rutini incele'
