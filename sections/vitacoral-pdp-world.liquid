{%- liquid
  assign title = 'Ürün dünyası'
  assign intro = 'Ürünü formu, içeriği ve rutindeki yeriyle birlikte değerlendirin.'
  assign note_title = 'İçerik notu'
  assign note_text = 'İçerik bilgisini ve kullanım önerisini birlikte okuyun.'
  assign note_more = ''
  assign routine_title = 'Rutin fikri'
  assign routine_text = 'Ürünü günlük alışkanlıklarınızla birlikte düşünün.'
  assign next_title = 'Sonraki adım'
  assign next_text = 'Karar vermeden önce kullanım ve uyarı bilgilerini kontrol edin.'
  assign pill_1 = 'İçerik'
  assign pill_2 = 'Kullanım'
  assign pill_3 = 'Uyarılar'
  assign micro_1 = ''
  assign micro_2 = ''
  assign micro_3 = ''
  assign cta_label = 'Ürünleri gör'
  assign cta_link = '/collections/all'

  case product.handle
    when 'collagen-30-sase'
      assign title = 'Collagen rutini'
      assign intro = 'Tip 1-2-3 hidrolize kolajen, Beauty Blend ve 30 saşelik pratik formu birlikte sunar.'
      assign note_text = 'Bir saşede Tip 1, Tip 2 ve Tip 3 hidrolize kolajen birlikte yer alır. Formül; C Vitamini, Hyaluronik Asit, Alfa Lipoik Asit, Glutatyon, Çinko, Koenzim Q10, E Vitamini, B vitaminleri, Bakır, Biotin ve Selenyum ile birlikte değerlendirilir.'
      assign note_more = 'Beauty Blend tarafında Hyaluronic Acid, Alpha-Lipoic Acid, Coenzyme Q10 ve Vitamin C öne çıkar. Limon aromalı saşe form, porsiyon takibini kolaylaştırır.'
      assign routine_text = '30 saşelik yapı, günlük kullanım düzeninizi takip etmeyi kolaylaştırır. Ürünü tek başına veya Women / Men rutini içinde değerlendirebilirsiniz.'
      assign next_text = 'Kolajen seçimini günlük multivitamin rutininizle birlikte düşünmek isterseniz ilgili rutin sayfasını inceleyin.'
      assign pill_1 = 'Tip 1-2-3'
      assign pill_2 = 'Beauty Blend'
      assign pill_3 = '30 saşe'
      assign micro_1 = 'C Vitamini'
      assign micro_2 = 'Hyaluronik Asit'
      assign micro_3 = 'Koenzim Q10'
      assign cta_label = 'Rutini incele'
      assign cta_link = '/pages/kadin-gunluk-rutini'
    when 'multivitamin-for-women'
      assign title = 'Kadın rutini'
      assign intro = '11 vitamin, 8 mineral, Quali-C ve Premium Women Blend ile kadın günlük rutinine odaklanır.'
      assign note_text = 'Formülde 11 vitamin ve 8 mineral bulunur. Quali-C patentli C vitamini ve Premium Women Blend, bu ürünü standart multivitamin bilgisinin ötesinde konumlandırır.'
      assign note_more = 'Premium Women Blend; Lutein, Likopen, Yaban Mersini ve Alfa-Lipoik Asit içerikleriyle kadın günlük rutininde ayrı bir içerik odağı sunar.'
      assign routine_text = 'Günlük multivitamin seçimini sadeleştirmek ve Collagen ile birlikte düşünmek isteyenler için uygun bir başlangıç noktasıdır.'
      assign next_text = 'Women ürününü Collagen ile birlikte değerlendirmek isterseniz kadın günlük rutini sayfasını inceleyin.'
      assign pill_1 = '11 vitamin'
      assign pill_2 = '8 mineral'
      assign pill_3 = 'Women Blend'
      assign micro_1 = 'Quali-C'
      assign micro_2 = 'Lutein'
      assign micro_3 = 'Yaban Mersini'
      assign cta_label = 'Rutini incele'
      assign cta_link = '/pages/kadin-gunluk-rutini'
    when 'multivitamin-for-men'
      assign title = 'Erkek rutini'
      assign intro = '11 vitamin, 8 mineral, Quali-C ve Premium Men Blend ile erkek günlük rutinine odaklanır.'
      assign note_text = 'Formülde 11 vitamin ve 8 mineral bulunur. Quali-C patentli C vitamini ve Premium Men Blend, erkek günlük multivitamin seçimini daha net okumanıza yardımcı olur.'
      assign note_more = 'Premium Men Blend; Lutein, Likopen, Isırgan Otu, Cüce Palmiye ve Beta-Glukan içerikleriyle erkek rutinine özel bir içerik çerçevesi sunar.'
      assign routine_text = 'Günlük multivitamin seçimini sadeleştirmek ve Collagen ile birlikte düşünmek isteyenler için uygun bir başlangıç noktasıdır.'
      assign next_text = 'Men ürününü Collagen ile birlikte değerlendirmek isterseniz erkek günlük rutini sayfasını inceleyin.'
      assign pill_1 = '11 vitamin'
      assign pill_2 = '8 mineral'
      assign pill_3 = 'Men Blend'
      assign micro_1 = 'Quali-C'
      assign micro_2 = 'Isırgan Otu'
      assign micro_3 = 'Beta-Glukan'
      assign cta_label = 'Rutini incele'
      assign cta_link = '/pages/erkek-gunluk-rutini'
    when 'multivitamin-for-kids'
      assign title = 'Kids seçimi'
      assign intro = '13 vitamin, 10 mineral, Norveç balık yağı ve EPA/DHA içeriğiyle ebeveyn kararına odaklanır.'
      assign note_text = 'Formülde 13 vitamin, 10 mineral ve balık yağı bulunur. Balık yağı içeriği IFOS onaylı, Halal sertifikalı ve Norveç menşei olarak belirtilir.'
      assign note_more = 'EPA/DHA içeriği, doğal çilek aroması ve şekersiz form bilgisi ebeveynlerin ürün seçimini daha net değerlendirmesine yardımcı olur.'
      assign routine_text = 'Çocuk ürünlerinde yaş, kullanım önerisi ve uyarı bilgileri kararın önemli parçasıdır. Ürün ebeveyn kontrolünde değerlendirilmelidir.'
      assign next_text = 'Kids ürününü aile rutini içinde Women ve Men ürünleriyle birlikte inceleyebilirsiniz.'
      assign pill_1 = '13 vitamin'
      assign pill_2 = 'EPA / DHA'
      assign pill_3 = 'Şekersiz'
      assign micro_1 = '10 mineral'
      assign micro_2 = 'Norveç yağı'
      assign micro_3 = 'Çilek aroma'
      assign cta_label = 'Aile rutini'
      assign cta_link = '/pages/aile-gunluk-rutini'
    when 'vitacoral-glucomannan-60-sase'
      assign title = 'Lif odağı'
      assign intro = 'Konjac kaynaklı glucomannan, vanilya aromalı saşe form ve 60 saşelik kullanım düzeniyle öne çıkar.'
      assign note_text = 'Glucomannan, konjac bitkisinden elde edilen çözünür lif odağıdır. Ürün, lif içeriğini saşe formunda değerlendirmek isteyenler için konumlanır.'
      assign note_more = 'Bu üründe içerik kadar kullanım önerisi, su tüketimi ve uyarı bilgileri de önemlidir. Karar vermeden önce etiket bilgisini dikkatle okuyun.'
      assign routine_text = 'Hafif rutin içinde, günlük düzeninize ve kullanım önerilerine uygunluğunu değerlendirmeniz için hazırlanmıştır.'
      assign next_text = 'Glucomannan ürününü hafif rutin seçenekleri içinde inceleyebilirsiniz.'
      assign pill_1 = 'Konjac lif'
      assign pill_2 = '60 saşe'
      assign pill_3 = 'Vanilya'
      assign micro_1 = 'Çözünür lif'
      assign micro_2 = 'Su uyarısı'
      assign micro_3 = 'Etiket önemli'
      assign cta_label = 'Rutini incele'
      assign cta_link = '/pages/hafif-rutin'
  endcase

  if product.metafields.custom.pdp_world_title != blank
    assign title = product.metafields.custom.pdp_world_title.value
  endif
  if product.metafields.custom.pdp_world_intro != blank
    assign intro = product.metafields.custom.pdp_world_intro.value
  endif
  if product.metafields.custom.pdp_note_title != blank
    assign note_title = product.metafields.custom.pdp_note_title.value
  endif
  if product.metafields.custom.pdp_ingredient_note != blank
    assign note_text = product.metafields.custom.pdp_ingredient_note.value
  endif
  if product.metafields.custom.pdp_ingredient_more != blank
    assign note_more = product.metafields.custom.pdp_ingredient_more.value
  endif
  if product.metafields.custom.pdp_routine_title != blank
    assign routine_title = product.metafields.custom.pdp_routine_title.value
  endif
  if product.metafields.custom.pdp_routine_note != blank
    assign routine_text = product.metafields.custom.pdp_routine_note.value
  endif
  if product.metafields.custom.pdp_next_title != blank
    assign next_title = product.metafields.custom.pdp_next_title.value
  endif
  if product.metafields.custom.pdp_next_step != blank
    assign next_text = product.metafields.custom.pdp_next_step.value
  endif
  if product.metafields.custom.pdp_pill_1 != blank
    assign pill_1 = product.metafields.custom.pdp_pill_1.value
  endif
  if product.metafields.custom.pdp_pill_2 != blank
    assign pill_2 = product.metafields.custom.pdp_pill_2.value
  endif
  if product.metafields.custom.pdp_pill_3 != blank
    assign pill_3 = product.metafields.custom.pdp_pill_3.value
  endif
  if product.metafields.custom.pdp_micro_1 != blank
    assign micro_1 = product.metafields.custom.pdp_micro_1.value
  endif
  if product.metafields.custom.pdp_micro_2 != blank
    assign micro_2 = product.metafields.custom.pdp_micro_2.value
  endif
  if product.metafields.custom.pdp_micro_3 != blank
    assign micro_3 = product.metafields.custom.pdp_micro_3.value
  endif
  if product.metafields.custom.pdp_cta_label != blank
    assign cta_label = product.metafields.custom.pdp_cta_label.value
  endif
  if product.metafields.custom.pdp_cta_link != blank
    assign cta_link = product.metafields.custom.pdp_cta_link.value
  endif
-%}

<section class="vc-pdp-world" id="VCProductWorld-{{ section.id }}">
  <div class="page-width">
    <div class="vc-pdp-world__shell">
      <div class="vc-pdp-world__hero">
        <p class="vc-pdp-world__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ title | escape }}</h2>
        <p>{{ intro | escape }}</p>
        <div class="vc-pdp-world__pills" role="list">
          <span role="listitem">{{ pill_1 | escape }}</span>
          <span role="listitem">{{ pill_2 | escape }}</span>
          <span role="listitem">{{ pill_3 | escape }}</span>
        </div>
      </div>

      <div class="vc-pdp-world__cards">
        <article class="vc-pdp-world__lead">
          <span>01</span>
          <h3>{{ note_title | escape }}</h3>
          <p>{{ note_text | escape }}</p>
          {%- if note_more != blank -%}
            <p class="vc-pdp-world__more">{{ note_more | escape }}</p>
          {%- endif -%}
          {%- if micro_1 != blank or micro_2 != blank or micro_3 != blank -%}
            <ul>
              {%- if micro_1 != blank -%}<li>{{ micro_1 | escape }}</li>{%- endif -%}
              {%- if micro_2 != blank -%}<li>{{ micro_2 | escape }}</li>{%- endif -%}
              {%- if micro_3 != blank -%}<li>{{ micro_3 | escape }}</li>{%- endif -%}
            </ul>
          {%- endif -%}
        </article>

        <article>
          <span>02</span>
          <h3>{{ routine_title | escape }}</h3>
          <p>{{ routine_text | escape }}</p>
        </article>

        <article class="vc-pdp-world__next">
          <span>03</span>
          <h3>{{ next_title | escape }}</h3>
          <p>{{ next_text | escape }}</p>
          <a href="{{ cta_link }}">{{ cta_label | escape }}</a>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .vc-pdp-world{padding:clamp(2rem,4vw,4.6rem) 0;background:linear-gradient(180deg,#fff,rgba(247,250,249,.82))}.vc-pdp-world__shell{display:grid;grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr);gap:1rem;align-items:stretch}.vc-pdp-world__hero{position:relative;overflow:hidden;min-height:28rem;padding:2rem;border-radius:2.2rem;background:radial-gradient(circle at 82% 14%,rgba(217,182,111,.38),transparent 28%),linear-gradient(135deg,#143430,#225952 62%,#173c37);color:#fff;box-shadow:0 1.4rem 3.4rem rgba(21,44,41,.14)}.vc-pdp-world__hero:after{content:"";position:absolute;right:-5rem;bottom:-5rem;width:15rem;height:15rem;border:.1rem solid rgba(255,255,255,.18);border-radius:999px}.vc-pdp-world__eyebrow{margin:0 0 .7rem;color:rgba(255,255,255,.7);font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:1rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.vc-pdp-world h2{position:relative;max-width:12ch;margin:0;color:#fff;font-family:var(--vitacoral-font-brand,"Gibbs Book",Arial,sans-serif);font-size:clamp(3rem,5vw,5rem);font-weight:650;letter-spacing:-.045em;line-height:.98}.vc-pdp-world__hero p:not(.vc-pdp-world__eyebrow){position:relative;max-width:48rem;margin:1.15rem 0 0;color:rgba(255,255,255,.88);font-size:1.42rem;line-height:1.56}.vc-pdp-world__pills{position:relative;display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.35rem}.vc-pdp-world__pills span{display:inline-flex;align-items:center;min-height:2.7rem;padding:.48rem .85rem;border:.1rem solid rgba(255,255,255,.2);border-radius:999px;background:rgba(255,255,255,.12);color:#fff;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:1rem;font-weight:850}.vc-pdp-world__cards{display:grid;grid-template-columns:1.2fr .86fr;grid-template-rows:1fr 1fr;gap:.85rem}.vc-pdp-world__cards article{display:grid;align-content:start;gap:.68rem;padding:1.35rem;border:.1rem solid rgba(34,89,82,.1);border-radius:1.8rem;background:rgba(255,255,255,.86);box-shadow:0 .9rem 2.2rem rgba(21,44,41,.045);backdrop-filter:blur(.4rem)}.vc-pdp-world__lead{grid-row:span 2;background:linear-gradient(180deg,#fff,rgba(248,250,249,.92))!important}.vc-pdp-world__cards span{color:#d0a85e;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:.96rem;font-weight:950;letter-spacing:.12em}.vc-pdp-world__cards h3{margin:0;color:var(--vitacoral-color-text,#16312e);font-family:var(--vitacoral-font-brand,"Gibbs Book",Arial,sans-serif);font-size:1.9rem;font-weight:650;letter-spacing:-.03em;line-height:1.06}.vc-pdp-world__cards p{margin:0;color:var(--vitacoral-color-text-muted,rgba(22,49,46,.76));font-size:1.18rem;line-height:1.5}.vc-pdp-world__more{color:rgba(22,49,46,.9)!important;font-weight:720}.vc-pdp-world__cards ul{display:grid;gap:.48rem;margin:.25rem 0 0;padding:0;list-style:none}.vc-pdp-world__cards li{position:relative;padding-left:1.15rem;color:#225952;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:1.05rem;font-weight:850}.vc-pdp-world__cards li:before{content:"";position:absolute;left:0;top:.62em;width:.42rem;height:.42rem;border-radius:999px;background:#d0a85e}.vc-pdp-world__next{background:linear-gradient(180deg,rgba(34,89,82,.08),#fff)!important}.vc-pdp-world__next a{align-self:end;justify-self:start;margin-top:.2rem;padding:.72rem 1.05rem;border-radius:999px;background:#225952;color:#fff;text-decoration:none;font-family:var(--vitacoral-font-ui,"Manrope",Arial,sans-serif);font-size:1.04rem;font-weight:900}@media screen and (max-width:989px){.vc-pdp-world__shell{grid-template-columns:1fr}.vc-pdp-world__hero{min-height:0}.vc-pdp-world__cards{grid-template-columns:1fr 1fr;grid-template-rows:auto}.vc-pdp-world__lead{grid-column:1/-1;grid-row:auto}.vc-pdp-world__next{grid-column:auto}}@media screen and (max-width:749px){.vc-pdp-world{padding:1.2rem 0 1.8rem}.vc-pdp-world .page-width{padding-left:1.6rem;padding-right:1.6rem}.vc-pdp-world__shell{gap:.72rem}.vc-pdp-world__hero{padding:1.35rem;border-radius:1.65rem;box-shadow:0 .9rem 2.2rem rgba(21,44,41,.13)}.vc-pdp-world h2{font-size:3rem}.vc-pdp-world__hero p:not(.vc-pdp-world__eyebrow){font-size:1.16rem;line-height:1.46}.vc-pdp-world__pills{gap:.42rem;margin-top:.95rem}.vc-pdp-world__pills span{min-height:2.25rem;padding:.34rem .62rem;font-size:.88rem}.vc-pdp-world__cards{grid-template-columns:1fr;gap:.62rem}.vc-pdp-world__cards article{padding:1.05rem;border-radius:1.45rem;box-shadow:none}.vc-pdp-world__cards h3{font-size:1.58rem}.vc-pdp-world__cards p{font-size:1.04rem;line-height:1.45}.vc-pdp-world__cards ul{gap:.36rem}.vc-pdp-world__cards li{font-size:.98rem}.vc-pdp-world__next a{padding:.68rem .95rem;font-size:.96rem}}
</style>

