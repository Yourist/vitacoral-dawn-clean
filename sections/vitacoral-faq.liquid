<section class="vitacoral-faq vitacoral-section" id="VitacoralFaq-{{ section.id }}">
  <div class="vitacoral-container">
    <div class="vitacoral-faq__layout">
      <div class="vitacoral-faq__intro vitacoral-reveal is-visible">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vitacoral-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="vitacoral-heading-lg">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="vitacoral-body vitacoral-faq__body rte">
            {{ section.settings.body }}
          </div>
        {%- endif -%}

        {%- if section.settings.cta_label != blank -%}
          <div class="vitacoral-faq__actions">
            <a
              {% if section.settings.cta_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.cta_link }}"
              {% endif %}
              class="vitacoral-button vitacoral-button--secondary"
            >
              {{ section.settings.cta_label | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>

      <div class="vitacoral-faq__items vitacoral-reveal is-visible">
        {%- if section.blocks.size > 0 -%}
          <div class="vitacoral-faq__accordion">
            {%- for block in section.blocks -%}
              <details class="vitacoral-faq__item vitacoral-faq__item--{{ block.settings.accent_style }}" {{ block.shopify_attributes }}>
                <summary class="vitacoral-faq__question">
                  <span>{{ block.settings.question | escape }}</span>
                </summary>
                <div class="vitacoral-faq__answer">
                  <p class="vitacoral-body">{{ block.settings.answer | escape }}</p>
                </div>
              </details>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="vitacoral-faq__empty vitacoral-card">
            <p class="vitacoral-body-muted">SSS soruları Tema Düzenleyici üzerinden eklenebilir.</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral FAQ",
  "tag": "section",
  "class": "section",
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Sık sorulanlar"},
    {"type":"inline_richtext","id":"heading","label":"Heading","default":"Alışveriş öncesi kısa cevaplar"},
    {"type":"richtext","id":"body","label":"Body","default":"<p>Vitacoral ürünlerini incelerken en sık merak edilen konuları kısa ve net şekilde yanıtladık.</p>"},
    {"type":"text","id":"cta_label","label":"Optional CTA label","default":"Tüm ürünleri gör"},
    {"type":"url","id":"cta_link","label":"Optional CTA link"}
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {"type":"text","id":"question","label":"Question"},
        {"type":"textarea","id":"answer","label":"Answer"},
        {"type":"select","id":"accent_style","label":"Accent style","default":"green","options":[{"value":"green","label":"green"},{"value":"orange","label":"orange"},{"value":"soft","label":"soft"}]}
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Vitacoral FAQ",
      "blocks": [
        {"type":"faq_item","settings":{"question":"Hangi Vitacoral ürününü seçmeliyim?","answer":"Önce ürün amacınıza bakın: Collagen, kadın veya erkek multivitamin, Kids ya da Glucomannan. Karar vermeden önce ürün sayfasındaki içerik ve kullanım bilgilerini kontrol edin.","accent_style":"green"}},
        {"type":"faq_item","settings":{"question":"Ürünleri birlikte alabilir miyim?","answer":"Bazı ürünler aynı alışverişte birlikte değerlendirilebilir. Her ürünün içerik, kullanım önerisi ve uyarı bilgilerini ayrı ayrı okumanızı öneririz.","accent_style":"soft"}},
        {"type":"faq_item","settings":{"question":"Belgeleri ve onayları nerede görebilirim?","answer":"Kalite belgeleri, hammadde sertifikaları ve Bakanlık onayları ilgili belge sayfalarında yer alır.","accent_style":"orange"}}
      ]
    }
  ]
}
{% endschema %}
