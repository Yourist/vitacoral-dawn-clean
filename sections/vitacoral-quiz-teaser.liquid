{{ 'vitacoral-quiz-polish.css' | asset_url | stylesheet_tag }}

<section class="vitacoral-quiz vitacoral-section" id="VitacoralQuiz-{{ section.id }}">
  <div class="vitacoral-container">
    <div class="vitacoral-quiz__layout vitacoral-card">
      <div class="vitacoral-quiz__content vitacoral-reveal is-visible">
        <p class="vitacoral-eyebrow">Ürün seçim anketi</p>
        <h2 class="vitacoral-heading-lg">Birkaç kısa soruyla başlangıç noktanızı bulun</h2>
        <div class="vitacoral-body vitacoral-quiz__body rte">
          <p>Anketi yanıtlayın; Vitacoral ürün seçeneklerini içerik, kullanım ve etiket bilgileriyle daha sade şekilde inceleyin.</p>
        </div>

        <div class="vitacoral-quiz__actions">
          <a href="{{ section.settings.cta_link | default: '/#quiz-0AH2J3O' }}" class="vitacoral-button">Anketi yanıtla</a>
        </div>

        <p class="vitacoral-body-muted vitacoral-quiz__note">Kısa sürer; teşhis veya tedavi önerisi sunmaz.</p>

        <div class="vitacoral-quiz__steps" aria-label="Anket adımları">
          <article class="vitacoral-quiz__step vitacoral-card">
            <span class="vitacoral-quiz__step-index">1</span>
            <div class="vitacoral-quiz__step-copy">
              <h3 class="vitacoral-quiz__step-title">Anketi açın</h3>
              <p class="vitacoral-body-muted">Kısa sorularla ürün seçiminize başlangıç yapın.</p>
            </div>
          </article>
          <article class="vitacoral-quiz__step vitacoral-card">
            <span class="vitacoral-quiz__step-index">2</span>
            <div class="vitacoral-quiz__step-copy">
              <h3 class="vitacoral-quiz__step-title">Soruları yanıtlayın</h3>
              <p class="vitacoral-body-muted">Alışveriş öncesi önceliklerinizi netleştirin.</p>
            </div>
          </article>
          <article class="vitacoral-quiz__step vitacoral-card">
            <span class="vitacoral-quiz__step-index">3</span>
            <div class="vitacoral-quiz__step-copy">
              <h3 class="vitacoral-quiz__step-title">Ürünleri inceleyin</h3>
              <p class="vitacoral-body-muted">Sonucu ürün detayları ve etiket bilgileriyle birlikte kontrol edin.</p>
            </div>
          </article>
        </div>
      </div>

      <div class="vitacoral-quiz__visual vitacoral-reveal is-visible">
        <div class="vitacoral-quiz__media">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                widths: '375, 550, 750, 900, 1200',
                sizes: '(min-width: 990px) 38vw, (min-width: 750px) 44vw, 100vw',
                loading: 'lazy',
                alt: 'Vitacoral ürün seçim anketi',
                class: 'vitacoral-quiz__image'
            }}
          {%- else -%}
            <div class="vitacoral-quiz__placeholder" aria-hidden="true">
              <span class="vitacoral-quiz__placeholder-chip">Kısa anket</span>
              <div class="vitacoral-quiz__placeholder-card">
                <span class="vitacoral-quiz__placeholder-mark"></span>
                <p class="vitacoral-heading-lg">Ürün seçiminizi birkaç adımda netleştirin.</p>
                <p class="vitacoral-body-muted">Anket sonucu bilgilendirme amaçlıdır; ürün detaylarını ayrıca inceleyin.</p>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral Anket",
  "tag": "section",
  "class": "section",
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type":"url","id":"cta_link","label":"CTA link"},
    {"type":"image_picker","id":"image","label":"Optional image"}
  ],
  "presets": [{"name":"Vitacoral Anket"}]
}
{% endschema %}
