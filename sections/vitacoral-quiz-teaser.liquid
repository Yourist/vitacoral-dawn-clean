{{ 'vitacoral-quiz-polish.css' | asset_url | stylesheet_tag }}

<section class="vitacoral-quiz vitacoral-section" id="VitacoralQuiz-{{ section.id }}">
  <div class="vitacoral-container">
    <div class="vitacoral-quiz__layout vitacoral-card">
      <div class="vitacoral-quiz__content vitacoral-reveal is-visible">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vitacoral-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="vitacoral-heading-lg">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="vitacoral-body vitacoral-quiz__body rte">
            {{ section.settings.body }}
          </div>
        {%- endif -%}

        <div class="vitacoral-quiz__actions">
          <a
            {% if section.settings.cta_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.cta_link }}"
            {% endif %}
            class="vitacoral-button"
          >
            {{ section.settings.cta_label | default: 'Anketi yanıtla' | escape }}
          </a>
        </div>

        {%- if section.settings.secondary_note != blank -%}
          <p class="vitacoral-body-muted vitacoral-quiz__note">{{ section.settings.secondary_note | escape }}</p>
        {%- endif -%}

        <div class="vitacoral-quiz__steps" aria-label="Anket adımları">
          <article class="vitacoral-quiz__step vitacoral-card">
            <span class="vitacoral-quiz__step-index">1</span>
            <div class="vitacoral-quiz__step-copy">
              <h3 class="vitacoral-quiz__step-title">{{ section.settings.step_1_title | default: 'Anketi açın' | escape }}</h3>
              <p class="vitacoral-body-muted">{{ section.settings.step_1_text | default: 'Kısa sorularla ürün seçiminize başlangıç yapın.' | escape }}</p>
            </div>
          </article>
          <article class="vitacoral-quiz__step vitacoral-card">
            <span class="vitacoral-quiz__step-index">2</span>
            <div class="vitacoral-quiz__step-copy">
              <h3 class="vitacoral-quiz__step-title">{{ section.settings.step_2_title | default: 'Soruları yanıtlayın' | escape }}</h3>
              <p class="vitacoral-body-muted">{{ section.settings.step_2_text | default: 'Alışveriş öncesi önceliklerinizi netleştirin.' | escape }}</p>
            </div>
          </article>
          <article class="vitacoral-quiz__step vitacoral-card">
            <span class="vitacoral-quiz__step-index">3</span>
            <div class="vitacoral-quiz__step-copy">
              <h3 class="vitacoral-quiz__step-title">{{ section.settings.step_3_title | default: 'Ürünleri inceleyin' | escape }}</h3>
              <p class="vitacoral-body-muted">{{ section.settings.step_3_text | default: 'Sonucu ürün detayları ve etiket bilgileriyle birlikte kontrol edin.' | escape }}</p>
            </div>
          </article>
        </div>
      </div>

      <div class="vitacoral-quiz__visual vitacoral-reveal is-visible">
        {%- assign quiz_image_alt = section.settings.heading | default: section.settings.eyebrow | strip_html | escape -%}
        <div class="vitacoral-quiz__media">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                widths: '375, 550, 750, 900, 1200',
                sizes: '(min-width: 990px) 38vw, (min-width: 750px) 44vw, 100vw',
                loading: 'lazy',
                alt: quiz_image_alt,
                class: 'vitacoral-quiz__image'
            }}
          {%- else -%}
            <div class="vitacoral-quiz__placeholder" aria-hidden="true">
              <span class="vitacoral-quiz__placeholder-chip">Kısa anket</span>
              <div class="vitacoral-quiz__placeholder-card">
                <span class="vitacoral-quiz__placeholder-mark"></span>
                <p class="vitacoral-heading-lg">Ürün seçiminizi birkaç adımda netleştirin.</p>
                <p class="vitacoral-body-muted">Anket sonucu bilgilendirme amaçlıdır; ürün detaylarını ayrıca inceleyin.</p>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral Anket",
  "tag": "section",
  "class": "section",
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Ürün seçim anketi"},
    {"type":"inline_richtext","id":"heading","label":"Heading","default":"Birkaç kısa soruyla başlangıç noktanızı bulun"},
    {"type":"richtext","id":"body","label":"Body","default":"<p>Anketi yanıtlayın; Vitacoral ürün seçeneklerini içerik, kullanım ve etiket bilgileriyle daha sade şekilde inceleyin.</p>"},
    {"type":"text","id":"cta_label","label":"CTA label","default":"Anketi yanıtla"},
    {"type":"url","id":"cta_link","label":"CTA link"},
    {"type":"text","id":"secondary_note","label":"Optional secondary note","default":"Kısa sürer; teşhis veya tedavi önerisi sunmaz."},
    {"type":"text","id":"step_1_title","label":"Step 1 title","default":"Anketi açın"},
    {"type":"text","id":"step_1_text","label":"Step 1 text","default":"Kısa sorularla ürün seçiminize başlangıç yapın."},
    {"type":"text","id":"step_2_title","label":"Step 2 title","default":"Soruları yanıtlayın"},
    {"type":"text","id":"step_2_text","label":"Step 2 text","default":"Alışveriş öncesi önceliklerinizi netleştirin."},
    {"type":"text","id":"step_3_title","label":"Step 3 title","default":"Ürünleri inceleyin"},
    {"type":"text","id":"step_3_text","label":"Step 3 text","default":"Sonucu ürün detayları ve etiket bilgileriyle birlikte kontrol edin."},
    {"type":"image_picker","id":"image","label":"Optional image"}
  ],
  "presets": [{"name":"Vitacoral Anket"}]
}
{% endschema %}
