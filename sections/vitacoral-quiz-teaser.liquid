<section class="vitacoral-quiz vitacoral-section" id="VitacoralQuiz-{{ section.id }}">
  <div class="vitacoral-container">
    <div class="vitacoral-quiz__layout vitacoral-card">
      <div class="vitacoral-quiz__content vitacoral-reveal is-visible">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vitacoral-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="vitacoral-heading-lg">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="vitacoral-body vitacoral-quiz__body rte">
            {{ section.settings.body }}
          </div>
        {%- endif -%}

        <div class="vitacoral-quiz__actions">
          <a
            {% if section.settings.cta_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.cta_link }}"
            {% endif %}
            class="vitacoral-button"
          >
            {{ section.settings.cta_label | default: 'Ankete Katıl' | escape }}
          </a>
        </div>

        {%- if section.settings.secondary_note != blank -%}
          <p class="vitacoral-body-muted vitacoral-quiz__note">{{ section.settings.secondary_note | escape }}</p>
        {%- endif -%}
      </div>

      <div class="vitacoral-quiz__visual vitacoral-reveal is-visible">
        {%- assign quiz_image_alt = section.settings.heading | default: section.settings.eyebrow | strip_html | escape -%}
        <div class="vitacoral-quiz__media">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                widths: '375, 550, 750, 900, 1200',
                sizes: '(min-width: 990px) 38vw, (min-width: 750px) 44vw, 100vw',
                loading: 'lazy',
                alt: quiz_image_alt,
                class: 'vitacoral-quiz__image'
            }}
          {%- else -%}
            <div class="vitacoral-quiz__placeholder" aria-hidden="true">
              <span class="vitacoral-quiz__placeholder-chip">Kısa anket</span>
              <div class="vitacoral-quiz__placeholder-card">
                <span class="vitacoral-quiz__placeholder-mark"></span>
                <p class="vitacoral-heading-lg">Sizin için uygun rutini birkaç adımda keşfedin.</p>
                <p class="vitacoral-body-muted">Sorular ilerledikçe sade bir ürün öneri akışına yönlenin.</p>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vitacoral Quiz",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Rutininizi Bulun"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Size en uygun Vitacoral ürününü birlikte bulalım"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Kısa anketi yanıtlayın, ihtiyacınıza uygun ürün önerilerini keşfedin.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Ankete Katıl"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "secondary_note",
      "label": "Optional secondary note",
      "default": "Kısa sürer, ürün seçiminizi kolaylaştırır."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Optional image"
    }
  ],
  "presets": [
    {
      "name": "Vitacoral Quiz"
    }
  ]
}
{% endschema %}
