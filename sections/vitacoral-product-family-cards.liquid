            "short_description": "Günlük tempo ve aktif yaşam rutinine uygun ürünleri birlikte keşfedin.",
            "included_products_text": "Men Multivitamin + Collagen",
            "cta_label": "Rutini keşfet",
            "accent_style": "green"
          }
        },
        {
          "type": "product_family",
          "settings": {
            "badge_text": "Aile rutini",
