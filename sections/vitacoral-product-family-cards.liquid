{{ 'vitacoral-home-routine-polish.css' | asset_url | stylesheet_tag }}
{{ 'vitacoral-home-routine-tune.css' | asset_url | stylesheet_tag }}

<span id="urun-secim-rehberi" class="vitacoral-anchor-target" aria-hidden="true"></span>

<section class="vitacoral-product-family vitacoral-section" id="VitacoralProductFamily-{{ section.id }}">
  <div class="vitacoral-container">
    <div class="vitacoral-product-family__header vitacoral-reveal is-visible">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vitacoral-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="vitacoral-heading-lg">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="vitacoral-body vitacoral-product-family__body rte">
          {{ section.settings.body }}
        </div>
      {%- endif -%}
    </div>

    <div class="vitacoral-product-family__carousel vitacoral-reveal is-visible">
      <ul class="vitacoral-product-family__grid list-unstyled" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign primary_product = block.settings.primary_product
            assign secondary_product = block.settings.secondary_product
            assign third_product = block.settings.third_product
            assign card_title = block.settings.title | strip
            if card_title == blank and primary_product != blank
              assign card_title = primary_product.title
            endif
            if card_title == blank
              assign card_title = 'Vitacoral ürün rehberi'
            endif

            assign card_image = block.settings.product_image
            if card_image == blank and primary_product != blank and primary_product.featured_image != blank
              assign card_image = primary_product.featured_image
            endif

            assign image_alt = card_title
            if card_image != blank and card_image.alt != blank
              assign image_alt = card_image.alt
            endif

            assign card_cta_link = block.settings.cta_link
            assign card_title_handle = card_title | handleize
            if card_cta_link == blank
              case card_title_handle
                when 'collagen-ile-baslayin'
                  assign card_cta_link = '/products/collagen-30-sase'
                when 'kadin-gunluk-destek', 'kadin-gunluk-rutini'
                  assign card_cta_link = '/pages/routine-women'
                when 'erkek-gunluk-destek', 'erkek-gunluk-rutini'
                  assign card_cta_link = '/pages/routine-men'
                when 'aile-icin-urunler', 'aile-gunluk-rutini'
                  assign card_cta_link = '/pages/routine-family'
                when 'lif-odagi', 'hafif-gunluk-rutin'
                  assign card_cta_link = '/pages/routine-light-women'
              endcase
            endif
            if card_cta_link == blank and primary_product != blank
              assign card_cta_link = primary_product.url
            endif
            if card_cta_link == blank
              assign card_cta_link = '#'
            endif

            assign card_cta_label = block.settings.cta_label | strip
            if card_cta_label == blank
              assign card_cta_label = 'Rehberi incele'
            endif
          -%}
          <li
            class="vitacoral-product-family__item vitacoral-product-family__item--{{ block.settings.accent_style }}"
            {{ block.shopify_attributes }}
          >
            <article class="vitacoral-product-family__card vitacoral-card vitacoral-lift">
              <div class="vitacoral-product-family__card-top">
                {%- if block.settings.badge_text != blank -%}
                  <span class="vitacoral-chip vitacoral-product-family__badge">
                    {{ block.settings.badge_text | escape }}
                  </span>
                {%- endif -%}

                <div class="vitacoral-product-family__media">
                  {%- if card_image != blank -%}
                    {{
                      card_image
                      | image_url: width: 900
                      | image_tag:
                        widths: '320, 450, 660, 900',
                        sizes: '(min-width: 990px) 20vw, (min-width: 750px) 30vw, 76vw',
                        loading: 'lazy',
                        alt: image_alt,
                        class: 'vitacoral-product-family__image'
                    }}
                  {%- else -%}
                    <div class="vitacoral-product-family__placeholder" aria-hidden="true">
                      <span class="vitacoral-product-family__placeholder-mark"></span>
                      <span class="vitacoral-body-muted">{{ card_title | escape }}</span>
                    </div>
                  {%- endif -%}
                </div>
              </div>

              <div class="vitacoral-product-family__content">
                <h3 class="vitacoral-product-family__title">{{ card_title }}</h3>

                {%- if block.settings.short_description != blank -%}
                  <p class="vitacoral-body vitacoral-product-family__description">
                    {{ block.settings.short_description | escape }}
                  </p>
                {%- endif -%}

                {%- if block.settings.included_products_text != blank -%}
                  <div class="vitacoral-product-family__includes">
                    <span class="vitacoral-product-family__includes-label">İçerik</span>
                    <p class="vitacoral-body-muted vitacoral-product-family__includes-text">
                      {{ block.settings.included_products_text | escape }}
                    </p>
                  </div>
                {%- endif -%}

                {%- if primary_product != blank or secondary_product != blank or third_product != blank -%}
                  <ul class="vitacoral-product-family__product-chips list-unstyled" aria-label="İlgili ürünler">
                    {%- if primary_product != blank -%}
                      <li class="vitacoral-chip vitacoral-chip--outline vitacoral-product-family__product-chip">
                        {{ primary_product.title | escape }}
                      </li>
                    {%- endif -%}
                    {%- if secondary_product != blank -%}
                      <li class="vitacoral-chip vitacoral-chip--outline vitacoral-product-family__product-chip">
                        {{ secondary_product.title | escape }}
                      </li>
                    {%- endif -%}
                    {%- if third_product != blank -%}
                      <li class="vitacoral-chip vitacoral-chip--outline vitacoral-product-family__product-chip">
                        {{ third_product.title | escape }}
                      </li>
                    {%- endif -%}
                  </ul>
                {%- endif -%}

                {%- if block.settings.optional_note != blank -%}
                  <p class="vitacoral-body-muted vitacoral-product-family__note">
                    {{ block.settings.optional_note | escape }}
                  </p>
                {%- endif -%}
              </div>

              <div class="vitacoral-product-family__actions">
                <a
                  href="{{ card_cta_link }}"
                  class="vitacoral-button{% if block.settings.accent_style == 'soft' %} vitacoral-button--secondary{% endif %}"
                >
                  {{ card_cta_label | escape }}
                </a>
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- if section.settings.bottom_cta_label != blank -%}
      <div class="vitacoral-product-family__footer vitacoral-reveal is-visible">
        <a
          {% if section.settings.bottom_cta_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.bottom_cta_link }}"
          {% endif %}
          class="vitacoral-button vitacoral-button--secondary"
        >
          {{ section.settings.bottom_cta_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ürün seçim rehberi",
  "tag": "section",
  "class": "section",
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow text","default":"Ürün Rehberi"},
    {"type":"inline_richtext","id":"heading","label":"Heading","default":"Hangi ürünle başlayacağınızı netleştirin"},
    {"type":"richtext","id":"body","label":"Body text","default":"<p>Günlük ihtiyacınıza göre Vitacoral ürün seçeneklerini inceleyin.</p>"},
    {"type":"text","id":"bottom_cta_label","label":"Bottom CTA label","default":"Tüm ürünleri gör"},
    {"type":"url","id":"bottom_cta_link","label":"Bottom CTA link"}
  ],
  "blocks": [
    {
      "type": "product_family",
      "name": "Ürün rehberi kartı",
      "settings": [
        {"type":"product","id":"primary_product","label":"Primary product"},
        {"type":"product","id":"secondary_product","label":"Secondary product"},
        {"type":"product","id":"third_product","label":"Third product"},
        {"type":"image_picker","id":"product_image","label":"Custom image"},
        {"type":"text","id":"badge_text","label":"Badge text","default":"Günlük destek"},
        {"type":"text","id":"title","label":"Title","default":"Ürün rehberi"},
        {"type":"textarea","id":"short_description","label":"Short description","default":"Ürünleri içerik ve kullanım bilgisiyle birlikte inceleyin."},
        {"type":"text","id":"included_products_text","label":"Included products text","default":"Vitacoral ürünleri"},
        {"type":"text","id":"cta_label","label":"CTA label","default":"Rehberi incele"},
        {"type":"url","id":"cta_link","label":"CTA link"},
        {"type":"textarea","id":"optional_note","label":"Optional note"},
        {"type":"select","id":"accent_style","label":"Accent style","default":"soft","options":[{"value":"orange","label":"Orange"},{"value":"green","label":"Green"},{"value":"soft","label":"Soft"}]}
      ]
    }
  ],
  "presets": [
    {"name":"Ürün seçim rehberi","blocks":[{"type":"product_family"},{"type":"product_family"},{"type":"product_family"}]}
  ]
}
{% endschema %}