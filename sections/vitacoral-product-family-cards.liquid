              "label": "soft"
            }
          ]
        },
        {
          "type": "text",
          "id": "optional_note",
          "label": "Optional note text"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Vitacoral Cards",
      "blocks": [
        {
          "type": "product_family",
          "settings": {
            "badge_text": "Kadın rutini",
            "title": "Kadın Rutin Paketi",
            "short_description": "Günlük multivitamin desteğini kolajen rutiniyle birlikte düşünenler için.",
            "included_products_text": "Women Multivitamin + Collagen",
            "cta_label": "Rutini keşfet",
            "accent_style": "orange"
          }
        },
        {
          "type": "product_family",
          "settings": {
            "badge_text": "Erkek rutini",
