            "short_description": "Kadınların günlük rutinine uygun multivitamin desteği.",
            "cta_label": "Women ürününü keşfet",
            "cta_link": "/products/women-multivitamin",
            "accent_style": "green"
          }
        },
        {
          "type": "product_family",
          "settings": {
            "badge_text": "Günlük rutin",
            "title": "Men Multivitamin",
            "short_description": "Erkeklerin günlük rutinine uygun multivitamin desteği.",
            "cta_label": "Men ürününü keşfet",
