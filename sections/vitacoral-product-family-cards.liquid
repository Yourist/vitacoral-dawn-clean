            "short_description": "Aile içinde farklı ihtiyaçlara göre günlük destek ürünlerini birlikte inceleyin.",
            "included_products_text": "Men + Women + Kids",
            "cta_label": "Rutini keşfet",
            "accent_style": "soft"
          }
        },
        {
          "type": "product_family",
          "settings": {
            "badge_text": "Hafif rutin",
